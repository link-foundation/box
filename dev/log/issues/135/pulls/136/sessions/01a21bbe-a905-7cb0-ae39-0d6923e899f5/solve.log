ction defaultFetcher(): callable\n    {\n        return static function (string $method, string $url, array $headers = []): array {\n            $headerLines = ['User-Agent: php-ai-driven-development-pipeline-template'];\n            foreach ($headers as $name => $value) {\n                $headerLines[] = \"{$name}: {$value}\";\n            }\n\n            $context = stream_context_create([\n                'http' => [\n                    'method' => $method,\n                    'timeout' => 30,\n                    'ignore_errors' => true,\n                    'header' => implode(\"\\r\\n\", $headerLines),\n                ],\n            ]);\n\n            // Do not reuse a previous response when this request cannot connect.\n            http_clear_last_response_headers();\n            $body = @file_get_contents($url, false, $context);\n            $status = self::statusFromHeaders(http_get_last_response_headers() ?? []);\n\n            return ['status' => $status, 'body' => $body === false ? '' : $body];\n        };\n    }\n\n    /**\n     * @param list<string> $headers\n     */\n    private static function statusFromHeaders(array $headers): int\n    {\n        foreach ($headers as $header) {\n            if (preg_match('#^HTTP/\\S+\\s+(\\d+)#', $header, $m)) {\n                return (int) $m[1];\n            }\n        }\n\n        return 0;\n    }\n}\n/tmp/tmp.SphAjo9zO6/php/tests/Pipeline/ReleasePreflightTest.php:52:        $check = $this->preflightAnswering(429, '')->checkPackagistRegistration();\n/tmp/tmp.SphAjo9zO6/php/tests/Pipeline/ReleasePreflightTest.php:55:        self::assertStringContainsString('answered 429', $check->detail);\n/tmp/tmp.SphAjo9zO6/php/tests/Pipeline/ReleasePreflightTest.php:137:        yield 'rate limit' => [429, ''];\n/tmp/tmp.SphAjo9zO6/php/tests/Pipeline/ReleasePreflightTest.php:138:        yield 'outage' => [503, ''];\n/tmp/tmp.SphAjo9zO6/php/tests/Pipeline/WorkflowPolicyTest.php:366:        // The invariant must have checke