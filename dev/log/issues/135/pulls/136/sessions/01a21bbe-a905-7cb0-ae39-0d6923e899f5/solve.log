ponent count. The size half of the\n12-gate had therefore never run — a measurement reporting 5 MB with a plausible\n13-component list was accepted as valid and committed to the README (issue #115).\n14-\n15-Doing it here also lets the same rules run on a pull request, where the file is\n16-edited by hand, without the three-hour measurement.\n17-\n18-Usage:\n19-  python3 scripts/ci/validate-measurements.py [FILE]\n20-                                              [--min-total-mb N]\n--\n38:REQUIRED_COMPONENT_KEYS = (\"name\", \"category\", \"size_mb\")\n39-\n40-\n41-def annotate(level, message, path):\n42-    \"\"\"Emit a GitHub Actions annotation as well as a plain line.\"\"\"\n43-    print(f\"::{level} file={path}::{message}\")\n44-\n45-\n46-def is_finite_number(value):\n47-    if not isinstance(value, (int, float)) or isinstance(value, bool):\n48-        return False\n49-    try:\n--\n86:    for key in (\"generated_at\", \"total_size_mb\", \"components\"):\n87-        if key not in data:\n88-            errors.append(f\"missing required key '{key}'\")\n89-\n90:    total = data.get(\"total_size_mb\")\n91-    if not is_finite_number(total):\n92:        errors.append(f\"total_size_mb must be a finite number, got {total!r}\")\n93-        total = None\n94-    elif total < args.min_total_mb:\n95-        errors.append(\n96:            f\"total_size_mb is {total} MB, below the {args.min_total_mb} MB floor \"\n97-            \"— the installation probably did not complete\"\n98-        )\n99-\n100-    components = data.get(\"components\")\n101-    if not isinstance(components, list):\n102-        errors.append(f\"components must be a list, got {type(components).__name__}\")\n103-        components = []\n104-    elif len(components) < args.min_components:\n105-        errors.append(\n106-            f\"only {len(components)} component(s) measured, expected at least \"\n107-            f\"{args.min_components}\"\n--\n119:        size = component.get(\"size_mb\")\n120-        if not is_finite_number(size):\n121:            errors.append(f\"{where}.size_mb must be a finite number, got {size!r}\")\n122-        elif size < 0:\n123:            errors.append(f\"{where}.size_mb is negative ({size})\")\n124-        else:\n125-            summed += size\n126-        debug(f\"{where}: {component.get('name')!r} = {size} MB\")\n127-\n128-    # The total is reported separately from the per-component numbers, so the\n129-    # two can disagree. A large gap means components went unattributed.\n130-    if components and (not math.isfinite(summed) or summed <= 0):\n131-        errors.append(\"components must add up to a positive finite size\")\n132-    elif total is not None and components:\n133-        drift = abs(total - summed) / max(total, 1.0)\n134:        debug(f\"total_size_mb={total}, sum(components)={summed:.1f}, drift={drift:.1%}\")\n135-        if drift > 0.5:\n136-            annotate(\n137-                \"warning\",\n138:                f\"total_size_mb ({total}) and the sum of the components \"\n139-                f\"({summed:.1f}) differ by {drift:.0%}\",\n140-                path,\n141-            )\n142-\n143-    if errors:\n144-        print(f\"{path}: INVALID\")\n145-        for error in errors:\n146-            print(f\"  - {error}\")\n147-            annotate(\"error\", error, path)\n148-        return 1\n149-\n{\"latestReviews\":[],\"reviewDecision\":\"\"}\n","exit_code":0,"status":"completed"}}
