[2026-11-27T07:05:08.939Z] [STDOUT] {"type":"item.completed","item":{"id":"item_197","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' scripts/ci/check-web-archive.mjs; sed -n '1,155p' dev/log/issues/135/pulls/136/research/lychee-v0.24.2-markdown.rs.txt; git diff 3a1181e\"'^..3a1181e --stat; sed -n '\"'1,210p' .github/workflows/measure-disk-space.yml\"","aggregated_output":"#!/usr/bin/env node\n\n/**\n * check-web-archive.mjs\n *\n * Reads lychee's markdown report, and for every broken URL asks the Wayback\n * Machine whether a snapshot exists. A broken link with a snapshot is reported\n * as a `::notice` carrying the replacement URL; a broken link without one is a\n * `::error`, because nothing can be done with it except fixing or removing it.\n *\n * Why this exists (issue #115, R3/R5): ported from the template's\n * scripts/check-web-archive.mjs, kept close to the original so fixes flow both\n * ways. The one behaviour that matters here is the one the template already\n * had: the script never rewrites a link and never silences one. It tells the\n * author which of the two possible fixes is available. Silencing belongs in\n * .lycheeignore, and only for a URL that is correct but unverifiable.\n *\n * The Wayback Availability API is documented at\n * https://archive.org/help/wayback_api.php - a single GET, no key, so a\n * documentation gate does not acquire a credential to run.\n *\n * Usage:\n *   node scripts/ci/check-web-archive.mjs\n *\n * Environment variables:\n *   LYCHEE_OUTPUT   Path to lychee's markdown output (default: lychee/out.md)\n *   RECOVERED_URLS  Path to the list of URLs the re-check\n *                   (scripts/ci/recheck-broken-links.mjs) found healthy after\n *                   lychee got no answer or a temporary HTTP error, one per line\n *                   (default: lychee/recovered.txt). Those URLs are skipped;\n *                   a missing file skips nothing.\n *   GITHUB_OUTPUT   Set by GitHub Actions; receives `all_archived`\n *\n * Exit codes:\n *   0  no broken links, or every broken link has an archived version\n *   1  at least one broken link has no archived version, or lychee reported a\n *      failure with no http(s) URL to look up (a missing local file, an\n *      unresolvable relative link)\n */\n\nimport { readFileSync, appendFileSync, existsSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport path from 'node:path';\n\nconst WAYBACK_API = 'https://archive.org/wayback/available?url=';\n\n/**\n * Write an output for later workflow steps, and echo it so a local run shows\n * the same value CI would act on.\n * @param {string} name - Output name\n * @param {string} value - Output value\n */\nfunction setOutput(name, value) {\n  const outputFile = process.env.GITHUB_OUTPUT;\n  if (outputFile) {\n    appendFileSync(outputFile, `${name}=${value}\\n`);\n  }\n  console.log(`${name}=${value}`);\n}\n\n/** Extract only failure sections, excluding successful redirects and summaries.\n * Legacy reports without per-input headings are parsed in full.\n */\nexport function extractErrorsSection(content) {\n  const lines = content.split('\\n');\n  const sections = [];\n  let depth = 0;\n  let hasSections = false;\n  for (const line of lines) {\n    const heading = /^(#+)\\s+(.+?)\\s*$/.exec(line);\n    if (heading && /per input$/.test(heading[2])) hasSections = true;\n    if (heading && depth && heading[1].length <= depth) depth = 0;\n    if (heading && /^(Errors|Timeouts) per input$/.test(heading[2])) {\n      depth = heading[1].length;\n    } else if (depth) {\n      sections.push(line);\n    }\n  }\n  return hasSections ? sections.join('\\n') : content;\n}\n\n/** Read the same failure entries for recovery and archive suggestions. */\nexport function readFailureEntries(content) {\n  const section = extractErrorsSection(content);\n  const pattern = /^[ \\t]*[*-][ \\t]+\\[([^\\]\\r\\n]+)\\][ \\t]+(?:<([^>\\r\\n]+)>|([^\\s<>|]+))(?:[ \\t]+\\(at [^)\\r\\n]*\\))?[ \\t]*(?:\\|[ \\t]*)?([^\\r\\n]*)$/gim;\n  return Array.from(section.matchAll(pattern), ([, marker, bracketed, bare, detail]) => ({\n    marker: marker.trim(),\n    url: bracketed ?? bare,\n    detail: detail.trim(),\n  }));\n}\n\n/** Require the reported failure total before issuing a recovery verdict. */\nexport function validateFailureReport(report, exitCode) {\n  const failures = readFailureEntries(report);\n  const rows = extractErrorsSection(report).match(/^[ \\t]*[*-][ \\t]+\\[/gm) ?? [];\n  const counts = new Map(\n    Array.from(report.matchAll(/^\\|[^|\\r\\n]*\\b(Errors|Timeouts|Unknown)[ \\t]*\\|[ \\t]*(\\d+)[ \\t]*\\|/gm),\n      ([, name, count]) => [name, Number(count)])\n  );\n  const total = (counts.get('Errors') ?? 0) + (counts.get('Timeouts') ?? 0);\n  if ((exitCode !== undefined && exitCode !== '2') ||\n      rows.length !== failures.length ||\n      (counts.size > 0 && total !== failures.length) ||\n      (counts.get('Unknown') ?? 0) > 0 ||\n      (exitCode === '2' &&\n        (!counts.has('Errors') || !counts.has('Timeouts') || total === 0 ||\n          !/^# Summary[ \\t]*\\r?$/m.test(report)))) {\n    throw new Error('The checker exit status or report is incomplete.');\n  }\n}\n\nexport function extractBrokenLinks(content) {\n  const urls = new Set();\n  const others = new Set();\n  for (const { url } of readFailureEntries(content)) {\n    (/^https?:\\/\\//i.test(url) ? urls : others).add(url);\n  }\n  return { urls: [...urls], others: [...others] };\n}\n\n/**\n * Extract broken http(s) URLs from lychee markdown output.\n * @param {string} content - The markdown content from lychee\n * @returns {string[]} Array of broken URLs\n */\nexport function extractBrokenUrls(content) {\n  return extractBrokenLinks(content).urls;\n}\n\n/**\n * Drop the URLs the re-check found healthy.\n *\n * A URL that never answered lychee but answers the re-check is not a broken\n * link (issue #121, lycheeverse/lychee#2297). Leaving it in this report would\n * send a healthy URL to the Wayback Machine and fail the job on whatever came\n * back - a false positive laundered through a second service.\n *\n * @param {string[]} urls - Broken http(s) URLs from the lychee report\n * @param {string} recoveredText - The re-check's output file, one URL per line\n * @returns {{remaining: string[], recovered: string[]}}\n */\nexport function splitRecoveredUrls(urls, recoveredText) {\n  const recoveredSet = new Set(\n    (recoveredText || '')\n      .split('\\n')\n      .map((line) => line.trim())\n      .filter(Boolean)\n  );\n\n  return {\n    remaining: urls.filter((url) => !recoveredSet.has(url)),\n    recovered: urls.filter((url) => recoveredSet.has(url)),\n  };\n}\n\n/**\n * Ask the Wayback Machine whether a URL has an archived snapshot.\n * @param {string} url - The URL to check\n * @returns {Promise<{available: boolean, archiveUrl?: string, timestamp?: string, error?: string}>}\n */\nexport async function checkWaybackMachine(url, { fetchImpl = fetch, timeoutMs = 10_000 } = {}) {\n  const apiUrl = `${WAYBACK_API}${encodeURIComponent(url)}`;\n\n  const controller = new AbortController();\n  const timeoutId = globalThis.setTimeout(() => controller.abort(), timeoutMs);\n\n  try {\n    const response = await fetchImpl(apiUrl, {\n      headers: {\n        'User-Agent': 'box-link-checker/1.0 (GitHub Actions CI)',\n      },\n      signal: controller.signal,\n    });\n\n    if (!response.ok) {\n      return { available: false, error: 'HTTP ' + response.status };\n    }\n\n    const data = await response.json();\n    const snapshots = data?.archived_snapshots;\n    if (!snapshots || typeof snapshots !== 'object' || Array.isArray(snapshots)) {\n      return { available: false, error: 'invalid snapshot response' };\n    }\n    const snapshot = snapshots.closest;\n    if (snapshot?.available === true) {\n      const archiveUrl = new URL(snapshot.url);\n      if (!['http:', 'https:'].includes(archiveUrl.protocol) ||\n          typeof snapshot.timestamp !== 'string') {\n        return { available: false, error: 'invalid snapshot URL or timestamp' };\n      }\n      archiveUrl.protocol = 'https:';\n      return { available: true, archiveUrl: archiveUrl.href, timestamp: snapshot.timestamp };\n    }\n    if (Object.keys(snapshots).length === 0 || snapshot?.available === false) {\n      return { available: false };\n    }\n    return { available: false, error: 'invalid snapshot response' };\n  } catch (error) {\n    return { available: false, error: error.message };\n  } finally {\n    globalThis.clearTimeout(timeoutId);\n  }\n}\n\n/**\n * Render a Wayback Machine timestamp (YYYYMMDDHHmmss) as a readable date\n * @param {string} timestamp - e.g. \"20231015143022\"\n * @returns {string} Date formatted as YYYY-MM-DD\n */\nexport function formatTimestamp(timestamp) {\n  if (!timestamp || timestamp.length < 8) {\n    return timestamp;\n  }\n  const year = timestamp.slice(0, 4);\n  const month = timestamp.slice(4, 6);\n  const day = timestamp.slice(6, 8);\n  return `${year}-${month}-${day}`;\n}\n\n/**\n * Report lychee errors that have no http(s) URL to look up in the Wayback\n * Machine. Local files and unresolvable root-relative links have no archived\n * equivalent, so they can never be `all_archived` and always fail the check.\n * @param {string[]} unarchivableLinks - Broken links that are not http(s) URLs\n */\nfunction reportUnarchivableLinks(unarchivableLinks) {\n  if (unarchivableLinks.length === 0) {\n    return;\n  }\n\n  console.log(\n    `✗ ${unarchivableLinks.length} broken link(s) cannot be checked against the Web Archive:`\n  );\n  for (const link of unarchivableLinks) {\n    console.log(`  ${link}`);\n    console.log(\n      '::error title=Broken link - not recoverable from the Web Archive::' +\n        `Broken link detected: ${link}\\n` +\n        'It is not an http(s) URL (missing file, unresolvable relative link, ...),\\n' +\nuse std::{\n    collections::{HashMap, HashSet},\n    fmt::{self, Display},\n};\n\nuse super::StatsFormatter;\nuse anyhow::Result;\nuse http::StatusCode;\nuse lychee_lib::{InputSource, ResponseBody, Status};\nuse std::fmt::Write;\nuse tabled::{\n    Table, Tabled,\n    settings::{Alignment, Modify, Style, object::Segment},\n};\n\nuse crate::formatters::{\n    host_stats::MarkdownHostStats,\n    stats::{OutputStats, ResponseStats},\n};\n\n#[derive(Tabled)]\nstruct StatsTableEntry {\n    #[tabled(rename = \"Status\")]\n    status: &'static str,\n    #[tabled(rename = \"Count\")]\n    count: usize,\n}\n\nfn stats_table(stats: &ResponseStats) -> String {\n    let stats = vec![\n        StatsTableEntry {\n            status: \"🔍 Total\",\n            count: stats.total,\n        },\n        StatsTableEntry {\n            status: \"🔗 Unique\",\n            count: stats.unique,\n        },\n        StatsTableEntry {\n            status: \"✅ Successful\",\n            count: stats.successful,\n        },\n        StatsTableEntry {\n            status: \"⏳ Timeouts\",\n            count: stats.timeouts,\n        },\n        StatsTableEntry {\n            status: \"🔀 Redirected\",\n            count: stats.redirects,\n        },\n        StatsTableEntry {\n            status: \"👻 Excluded\",\n            count: stats.excludes,\n        },\n        StatsTableEntry {\n            status: \"❓ Unknown\",\n            count: stats.unknown,\n        },\n        StatsTableEntry {\n            status: \"🚫 Errors\",\n            count: stats.errors,\n        },\n        StatsTableEntry {\n            status: \"⛔ Unsupported\",\n            count: stats.unsupported,\n        },\n    ];\n    let style = Style::markdown();\n\n    Table::new(stats)\n        .with(Modify::new(Segment::all()).with(Alignment::left()))\n        .with(style)\n        .to_string()\n}\n\n/// Helper function to format single response body as markdown\n///\n/// Optional details get added if available.\nfn markdown_response(response: &ResponseBody) -> Result<String> {\n    let mut formatted = format!(\n        \"* [{}] <{}>\",\n        response.status.code_as_string(),\n        response.uri,\n    );\n\n    if let Some(span) = response.span {\n        formatted = format!(\"{formatted} (at {span})\");\n    }\n\n    if let Status::Ok(StatusCode::OK) = response.status {\n        // Don't print anything else if the status code is 200.\n        // The output gets too verbose then.\n        return Ok(formatted);\n    }\n\n    // Add a separator between the URI and the additional details below.\n    // Note: To make the links clickable in some terminals,\n    // we add a space before the separator.\n    let details = response.status.details();\n    write!(formatted, \" | {details}\")?;\n\n    Ok(formatted)\n}\n\nstruct MarkdownResponseStats(ResponseStats);\n\nimpl Display for MarkdownResponseStats {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        let stats = &self.0;\n\n        writeln!(f, \"# Summary\")?;\n        writeln!(f)?;\n        writeln!(f, \"{}\", stats_table(&self.0))?;\n\n        write_stats_per_input(f, \"Errors\", &stats.error_map, |response| {\n            markdown_response(response).map_err(|_| fmt::Error)\n        })?;\n\n        write_stats_per_input(f, \"Timeouts\", &stats.timeout_map, |response| {\n            markdown_response(response).map_err(|_| fmt::Error)\n        })?;\n\n        write_stats_per_input(f, \"Redirects\", &stats.redirect_map, |redirects| {\n            Ok(format!(\"* {redirects}\"))\n        })?;\n\n        write_stats_per_input(f, \"Suggestions\", &stats.suggestion_map, |suggestion| {\n            Ok(format!(\"* {suggestion}\"))\n        })?;\n\n        Ok(())\n    }\n}\n\nfn write_stats_per_input<T, F>(\n    f: &mut fmt::Formatter<'_>,\n    name: &'static str,\n    map: &HashMap<InputSource, HashSet<T>>,\n    write_stat: F,\n) -> fmt::Result\nwhere\n    T: Display,\n    F: Fn(&T) -> Result<String, std::fmt::Error>,\n{\n    if !&map.is_empty() {\n        writeln!(f, \"\\n## {name} per input\")?;\n        for (source, responses) in super::sort_stat_map(map) {\n            writeln!(f, \"\\n### {name} in {source}\\n\")?;\n            for response in responses {\n                writeln!(f, \"{}\", write_stat(response)?)?;\n            }\n        }\n    }\n\n    Ok(())\n .github/workflows/links.yml                |  1 +\n experiments/test-issue135-link-verdicts.sh | 18 +++++++++++-------\n scripts/ci/check-web-archive.mjs           | 24 +++++++++++++++++++++++-\n scripts/ci/recheck-broken-links.mjs        | 14 ++------------\n 4 files changed, 37 insertions(+), 20 deletions(-)\nname: Measure Disk Space and Update README\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - 'scripts/ubuntu-24-server-install.sh'\n      - 'scripts/measure-disk-space.sh'\n      - 'scripts/update-readme-sizes.sh'\n      - 'Dockerfile'\n      - '.github/workflows/measure-disk-space.yml'\n  # The measurement itself takes ~3 hours and pushes to main, so it cannot run\n  # on a pull request. What CAN run on a pull request is everything that decides\n  # whether the measurement is going to work at all — and it has to, because\n  # this workflow only ever ran after the merge. Run 33972074753 (main, commit\n  # 42be663) is the case in point: `NODE_MAJOR: unbound variable` was\n  # introduced, reviewed and merged without a single job ever executing the\n  # changed script (issue #115).\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      - 'scripts/ubuntu-24-server-install.sh'\n      - 'scripts/measure-disk-space.sh'\n      - 'scripts/update-readme-sizes.sh'\n      - 'ubuntu/24.04/common.sh'\n      - 'data/disk-space-measurements.json'\n      - '.github/workflows/measure-disk-space.yml'\n      # The preflight and validation jobs, which are what a pull request can\n      # run here, are the only place these three are executed at all. They are\n      # deliberately absent from the push filter above: editing a validator\n      # should re-run the validation, not spend three hours measuring disk.\n      - 'scripts/ci/extract-quoted-heredoc.sh'\n      - 'scripts/ci/validate-measurements.py'\n      - 'scripts/ci/summarize-measurements.py'\n      - 'scripts/ci/run-with-budget-warning.sh'\n      - 'experiments/test-issue125-budget-state-survives-tmp-cleanup.sh'\n      - 'experiments/test-issue135-measure-workflow.sh'\n  # Allow manual trigger\n  workflow_dispatch:\n    inputs:\n      force_update:\n        description: 'Force update README even if no changes detected'\n        required: false\n        type: boolean\n        default: false\n      verbose:\n        description: 'Trace what the measurement script resolves, generates and hands to the box user (BOX_VERBOSE=1)'\n        required: false\n        type: boolean\n        default: false\n\n# Least-privilege default; the measurement job escalates to `contents: write`\n# for its push. The validation job never needs more than a read.\npermissions:\n  contents: read\n\nenv:\n  # actions/checkout's first act is `git init`, and a git with no configured\n  # `init.defaultBranch` answers it with a thirteen-line advice block - \"Using\n  # 'master' as the name for the initial branch... this default branch name will\n  # change\" - at the top of every job log. 19 checkouts in the runs issue #121\n  # lists printed 247 lines of it, in jobs where nothing was wrong. No step can\n  # fix it, because it is printed before the first step of ours runs; git reads\n  # configuration from the environment too, and the environment is there from\n  # the start. Ported from the js template, which carries the same three lines\n  # with the same reasoning.\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # Fast pre-merge gate. Nothing here installs anything, so it finishes in\n  # under a minute and can run on every pull request that touches the scripts.\n  validate:\n    name: Validate measurement scripts\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-validate\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      - name: Syntax-check the scripts\n        run: |\n          for f in scripts/measure-disk-space.sh scripts/ubuntu-24-server-install.sh scripts/update-readme-sizes.sh; do\n            echo \"bash -n $f\"\n            bash -n \"$f\"\n          done\n\n      # The generated script is written from a quoted heredoc, so `bash -n` on\n      # the parent says nothing about it. Extract it and check it separately.\n      #\n      # The extraction used to be an inline awk pattern that hardcoded the\n      # spacing of the opener (`cat > /tmp/box-measure.sh <<`). shfmt then\n      # reformatted the script to `cat >/tmp/box-measure.sh <<'EOF_BOX'` and the\n      # pattern matched nothing, failing this job on every push (issue #115,\n      # RC-22). The extraction now matches what bash parses rather than how the\n      # line happens to be formatted, and says which of \"no opener\", \"no\n      # terminator\" and \"empty body\" it hit.\n      - name: Syntax-check the generated box-user script\n        run: |\n          bash scripts/ci/extract-quoted-heredoc.sh \\\n            scripts/measure-disk-space.sh EOF_BOX > /tmp/generated-measure.sh\n          echo \"extracted $(wc -l < /tmp/generated-measure.sh) lines\"\n          bash -n /tmp/generated-measure.sh\n\n      - name: Check for variables leaking out of quoted heredocs\n        run: bash scripts/ci/check-heredoc-vars.sh\n\n      - name: Regression tests for issue #115\n        run: bash experiments/test-issue115-heredoc-unbound-vars.sh\n\n      # Argument handling is the other half of what broke: the documented\n      # no-argument invocation used to abort on `$1: unbound variable`.\n      - name: Regression tests for measurement output and budget state\n        run: |\n          bash experiments/test-issue125-budget-state-survives-tmp-cleanup.sh\n          bash experiments/test-issue135-measure-workflow.sh\n\n      - name: Check the command line interface\n        run: |\n          ./scripts/measure-disk-space.sh --help > /dev/null\n          if ./scripts/measure-disk-space.sh --not-an-option 2>/dev/null; then\n            echo \"::error::an unknown option must be rejected\"; exit 1\n          fi\n\n      # The committed measurements feed the README table; a malformed file\n      # would only be noticed three hours into the next measurement run.\n      - name: Validate the committed measurements\n        run: python3 scripts/ci/validate-measurements.py data/disk-space-measurements.json\n\n  measure-disk-space:\n    name: Measure Component Disk Space\n    # Pull requests stop at `validate`; measuring installs every toolchain on a\n    # bare runner and ends in a push to main.\n    if: github.event_name != 'pull_request'\n    needs: validate\n    runs-on: ubuntu-24.04\n    # 180 was \"3 hours max for full installation measurement\" - a number nobody\n    # had checked against a run. Every successful run of this job in the\n    # repository's history finished inside 23.3 minutes, the slowest of them in\n    # February (dev/log/issues/121/pulls/122/analysis/); 60 leaves more than\n    # twice that and still bounds a hang at an hour instead of three (issue\n    # #121, docs/CI-TIMEOUT-BUDGETS.md).\n    timeout-minutes: 60\n    # This job commits to main. Cancelling it mid-`git push` is worse than\n    # letting a superseded run finish, so it queues instead of cancelling —\n    # unlike the pre-merge checks above.\n    concurrency:\n      group: measure-disk-space-${{ github.ref }}\n      cancel-in-progress: false\n\n    # pull-requests: write is for the fallback path in\n    # scripts/release/git-push-with-retry.sh only (issue #121).\n    permissions:\n      contents: write\n      pull-requests: write\n\n    env:\n      # Off by default. `workflow_dispatch` can turn it on without editing the\n      # workflow, which is the whole point of having it (issue #115).\n      BOX_VERBOSE: ${{ inputs.verbose && '1' || '0' }}\n\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Kept, unlike every other checkout here: this job commits the\n          # measured table back to main, so the push needs the credential\n          # checkout leaves in .git/config. Stated rather than left to the\n          # default, so the one job that needs it is the one that says so.\n          persist-credentials: true\n          fetch-depth: 0\n          token: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Free up disk space\n        run: |\n          echo \"=== Initial disk space ===\"\n          df -h /\n\n          echo \"\"\n          echo \"=== Freeing up disk space ===\"\n\n          # Remove large directories that won't affect apt functionality\n          # NOTE: We intentionally do NOT run apt-get remove/autoremove as it breaks\n          # package installation. See docs/case-studies/issue-29 for details.\n          sudo rm -rf /usr/share/dotnet\n          sudo rm -rf /usr/local/lib/android\n          sudo rm -rf /opt/ghc\n          sudo rm -rf /opt/hostedtoolcache\n          sudo rm -rf /usr/local/share/boost\n          sudo rm -rf \"$AGENT_TOOLSDIRECTORY\"\n\n          # Refresh apt cache to ensure all packages are available\n          source ubuntu/24.04/common.sh\n          apt_update_with_retry\n\n          echo \"\"\n","exit_code":0,"status":"completed"}}
