      run: |\n297:              echo \"::error title=Measurement validation could not run::validate-measurements.py exited $rc, which is neither valid (0) nor invalid (1). The measurement is not being discarded on the strength of an answer nobody got.\"\n302:      - name: Commit and push changes\n303:        if: steps.changes.outputs.has_changes == 'true' && steps.validate.outputs.valid == 'true'\n308:        run: |\n340:      - name: Fail on invalid measurements\n341:        if: steps.validate.outputs.valid != 'true'\n342:        run: |\n348:      # of what the three-hour run did, and a plain step without `if:` is\n364:      - name: Upload measurement artifacts\n365:        if: ${{ !cancelled() && (steps.measure.outcome == 'success' || steps.measure.outcome == 'failure') }}\n366:        uses: actions/upload-artifact@v7\n368:          name: disk-space-measurements\n375:      - name: Summary\n376:        if: ${{ !cancelled() }}\n377:        run: |\n414:    name: pipeline-status\n418:    if: ${{ !cancelled() }}\n427:      - name: Check pipeline status\n432:        run: bash scripts/ci/check-pipeline-status.sh\n82\ntotal 4\n-rw-r--r-- 1 box box 1711 Nov 27 06:42 issue-68-playwright-warning.txt\n/usr/bin/docker\n/home/box/.nvm/versions/node/v26.13.1/bin/node\nv26.13.1\n2095b5c fix(ci): retry temporary HTTP failures in the links gate\n09549d9 Give the box user the home directory useradd refused to make (issue #123)\nc151dd5 fix: give brew link back its own exit status at all four sites (issue #123)\ncd25f22 fix: make both artifact uploads fail when the evidence is missing (issue #123)\ne3a9648 Retire the apt \"hardening\" item by measuring apt's own defaults (issue #123)\n4139d54 Stop untrusted text from becoming annotations, and stop `tee /dev/stderr` from erasing the log (issue #123)\n7f2fb1e docs: re-measure every number this branch quotes about itself (issue #121)\ne724270 ci: make every checkout say what happens to the job token, and check that it matches (issue #12