[2026-11-27T07:53:52.158Z] [STDOUT] {"type":"item.completed","item":{"id":"item_542","type":"command_execution","command":"/bin/bash -lc \"sed -n '425,558p' .github/workflows/release.yml; sed -n '640,735p' .github/workflows/release.yml; sed -n '174,196p' .github/workflows/pr-tests.yml; gh run view 45960902436 -R link-foundation/box --json jobs,conclusion --jq '[.conclusion,[.jobs[]|select(.name|contains(\\\"pr-test\\\"))|[.name,.status,.conclusion]]]'; gh run view 45961312734 -R link-foundation/box --json jobs,conclusion --jq '[.conclusion,[.jobs[]|select(.name|contains(\\\"pr-test\\\"))|[.name,.status,.conclusion]]]'\"","aggregated_output":"          else\n            bash scripts/release/preflight-credentials.sh --mode release\n          fi\n\n  # === DETECT CHANGES (per-image granularity) ===\n  detect-changes:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    needs: [apply-changesets, version-bump]\n    # Always run, but wait for version jobs if they're running\n    if: ${{ !cancelled() && (needs.apply-changesets.result == 'success' || needs.apply-changesets.result == 'skipped') && (needs.version-bump.result == 'success' || needs.version-bump.result == 'skipped') }}\n    outputs:\n      # Legacy change detection\n      docker-changed: ${{ steps.detect.outputs.docker }}\n      scripts-changed: ${{ steps.detect.outputs.scripts }}\n      ubuntu-changed: ${{ steps.detect.outputs.ubuntu }}\n      workflow-changed: ${{ steps.detect.outputs.workflow }}\n      version-changed: ${{ steps.detect.outputs.version }}\n      should-build: ${{ steps.detect.outputs.should-build }}\n      version: ${{ steps.version.outputs.version }}\n      # Per-image change detection\n      js-changed: ${{ steps.detect.outputs.js }}\n      essentials-changed: ${{ steps.detect.outputs.essentials }}\n      full-changed: ${{ steps.detect.outputs.full }}\n      common-changed: ${{ steps.detect.outputs.common }}\n      # Per-language change detection\n      python-changed: ${{ steps.detect.outputs.python }}\n      go-changed: ${{ steps.detect.outputs.go }}\n      rust-changed: ${{ steps.detect.outputs.rust }}\n      java-changed: ${{ steps.detect.outputs.java }}\n      kotlin-changed: ${{ steps.detect.outputs.kotlin }}\n      ruby-changed: ${{ steps.detect.outputs.ruby }}\n      php-changed: ${{ steps.detect.outputs.php }}\n      perl-changed: ${{ steps.detect.outputs.perl }}\n      swift-changed: ${{ steps.detect.outputs.swift }}\n      lean-changed: ${{ steps.detect.outputs.lean }}\n      rocq-changed: ${{ steps.detect.outputs.rocq }}\n      cpp-changed: ${{ steps.detect.outputs.cpp }}\n      assembly-changed: ${{ steps.detect.outputs.assembly }}\n      dotnet-changed: ${{ steps.detect.outputs.dotnet }}\n      r-changed: ${{ steps.detect.outputs.r }}\n      # dind-box change detection (issue #80)\n      dind-changed: ${{ steps.detect.outputs.dind }}\n\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          # Full history so detect-changes.sh can resolve the synthetic merge\n          # commit's parents (HEAD^2^..HEAD^2 per-commit PR diff — issue #108).\n          fetch-depth: 0\n          ref: ${{ github.ref }}\n          # `git fetch origin main` below is an anonymous read of a public\n          # repository; nothing in this job writes to the remote.\n          persist-credentials: false\n\n      # Re-fetch if version was bumped to get latest commit\n      - name: Fetch latest changes\n        if: needs.version-bump.outputs.version_bumped == 'true' || needs.apply-changesets.outputs.version_bumped == 'true'\n        run: |\n          git fetch origin main\n          git checkout main\n          git pull origin main\n\n      # This is where the version of a release is decided; every other job is\n      # handed this output rather than reading VERSION again (issue #123). An\n      # empty or unparsable VERSION file stops the release here instead of\n      # becoming an empty image tag six jobs later.\n      - name: Get version from VERSION file\n        id: version\n        run: bash scripts/release/release-version.sh\n\n      # Single source of truth for change detection (issue #108).\n      #\n      # The crux of the fix: for pull_request events this script diffs only the\n      # PR head's latest commit (HEAD^2^..HEAD^2 against the synthetic merge\n      # commit), not the whole-PR diff against the base SHA. A trivial\n      # synchronize commit (.gitkeep, docs, Markdown) therefore skips the\n      # expensive build/test matrix even when earlier commits on the same PR\n      # changed image source — those were already tested when pushed. For push\n      # events it diffs the full pushed range (github.event.before..HEAD) so the\n      # release build is never skipped. The classification logic lives in\n      # scripts/ci/detect-changes.sh and is unit-tested by\n      # experiments/test-issue108-detect-changes.sh.\n      - name: Detect changes\n        id: detect\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          PUSH_BEFORE_SHA: ${{ github.event.before }}\n        run: bash scripts/ci/detect-changes.sh\n\n  # === IMAGE BUILDS ===\n  #\n  # One caller job per image family (issue #115, RC-8). Each `uses:` runs the jobs\n  # of the named file as part of *this* run, so the Actions UI still shows one\n  # release run; the checks are renamed `<caller-job>/ <job name>`.\n  #\n  # Every per-job `if:` moved with its job. What used to be\n  # `needs.<upstream-job>.result` is passed in as an input instead, because a\n  # called workflow cannot read the caller's `needs` context - that is what the\n  # `status` job in each file exists to publish. The conditions themselves are\n  # unchanged, so a failure in one architecture still has exactly the effect it\n  # had before the split.\n  #\n  # The guard below is the prefix every build job carried; it is hoisted here\n  # once. Its `!cancelled()` matters: a caller job whose `needs` failed still\n  # runs, so a broken family does not silently skip create-release.\n  js:\n    needs: [detect-changes, preflight]\n    if: |\n      !cancelled() &&\n      needs.preflight.result == 'success' &&\n      needs.detect-changes.result == 'success' &&\n      (\n        (github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.detect-changes.outputs.should-build == 'true') ||\n        (github.event_name == 'workflow_dispatch')\n      )\n    permissions:\n      contents: read\n      packages: write\n    uses: ./.github/workflows/release-js.yml\n    with:\n      changes: ${{ toJSON(needs.detect-changes.outputs) }}\n    secrets:\n      DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}\n      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n\n  essentials:\n    needs: [detect-changes, preflight, js]\n    if: |\n      !cancelled() &&\n      needs.preflight.result == 'success' &&\n      needs.detect-changes.result == 'success' &&\n      (\n    with:\n      changes: ${{ toJSON(needs.detect-changes.outputs) }}\n      js-manifest-result: ${{ needs.js.outputs.manifest-result }}\n      essentials-manifest-result: ${{ needs.essentials.outputs.manifest-result }}\n      languages-manifest-result: ${{ needs.languages.outputs.manifest-result }}\n      full-manifest-result: ${{ needs.full.outputs.manifest-result }}\n    secrets:\n      DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}\n      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n\n  # === PULL REQUEST TESTS ===\n  #\n  # Same idea, for the six pr-test tiers and the docker-build-test roll-up.\n  # `version-check` and `changeset-check` only exist on a pull request, so their\n  # results are passed in rather than re-derived.\n  pr-tests:\n    needs: [detect-changes, version-check, changeset-check]\n    if: ${{ !cancelled() && github.event_name == 'pull_request' }}\n    permissions:\n      contents: read\n      actions: write\n    uses: ./.github/workflows/pr-tests.yml\n    with:\n      changes: ${{ toJSON(needs.detect-changes.outputs) }}\n      detect-changes-result: ${{ needs.detect-changes.result }}\n      version-check-result: ${{ needs.version-check.result }}\n      changeset-check-result: ${{ needs.changeset-check.result }}\n\n\n  # === CREATE GITHUB RELEASE ===\n  create-release:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    needs: [detect-changes, preflight, js, essentials, languages, full, dind]\n    # The release is created from the source state, not from the registry\n    # (issue #115; hive-mind principle #13, \"never gate the release on an image\n    # push\"). It waits for the manifest jobs so the notes can report what was\n    # published, but `needs.full.result == 'success'` is deliberately\n    # NOT required: a Docker Hub outage or an expired registry token used to\n    # mean the tagged commit got no GitHub Release at all, and the release for\n    # that version then had to be created by hand. Only detect-changes is\n    # required, because its output is what decides there is anything to release.\n    # The notes say per image which references actually resolve, so a partial\n    # push produces an honest release instead of no release.\n    if: |\n      !cancelled() &&\n      needs.preflight.result == 'success' &&\n      needs.detect-changes.result == 'success' &&\n      (\n        (github.event_name == 'push' && github.ref == 'refs/heads/main') ||\n        (github.event_name == 'workflow_dispatch')\n      )\n    permissions:\n      contents: write\n      packages: read\n\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n          ref: main\n\n      # The release notes and the git tag name the same version the six build\n      # workflows tagged their images with, because all seven are handed the one\n      # detect-changes computed (issue #123). The `git pull origin main || true`\n      # that used to open this step could only pull in a commit pushed *after*\n      # this release started - see scripts/release/release-version.sh.\n      - name: Get latest version\n        id: version\n        env:\n          PIPELINE_VERSION: ${{ needs.detect-changes.outputs.version }}\n        run: bash scripts/release/release-version.sh\n\n      # There is deliberately no `docker login` in this job (issue #117).\n      #\n      # There used to be one, on the reasoning that an anonymous\n      # `docker manifest inspect` cannot tell \"this package does not exist\"\n      # from \"you may not look at it\". True, and it made the check useless: it\n      # then measured what the publisher could see. The notes for v2.6.0 said\n      # \"28 of 56 image references resolve\" while every one of the 56 was\n      # unreachable for everybody else - the GHCR packages private, Docker Hub\n      # empty behind an expired token.\n      #\n      # scripts/release/registry-probe.sh makes the distinction without a\n      # credential: on GHCR a private package refuses the anonymous *token*\n      # request with 401 while a missing one still issues a token and answers\n      # 404 on the manifest. So the notes are now written from the reader's\n      # view, which is the only view that decides whether a release happened.\n\n      # The notes are generated from one image list by\n      # scripts/release/build-release-notes.sh. They used to be 106 lines of\n      # inline heredoc with a hand-written row per image, split across two steps\n      # only to stay under GitHub's 21000-character per-step expression limit\n      # (issue #80) - a limit a script does not have (issue #115).\n      - name: Build release notes\n            echo \"$fn -> $value\"\n            [ -n \"$value\" ] || { echo \"::error::$fn returned nothing\"; exit 1; }\n          done\n\n  # --- Tier 1: JS box ---\n  pr-test-js:\n    name: pr-test / js\n    runs-on: ubuntu-24.04\n    # Measured maximum 7.9 minutes; the budgets below reserve 13 of these 20.\n    timeout-minutes: 20\n    needs: [pr-test-version-policy]\n    if: |\n      !cancelled() &&\n      inputs.detect-changes-result == 'success' &&\n      (inputs.version-check-result == 'success' || inputs.version-check-result == 'skipped') &&\n      (inputs.changeset-check-result == 'success' || inputs.changeset-check-result == 'skipped') &&\n      github.event_name == 'pull_request' &&\n      fromJSON(inputs.changes)['should-build'] == 'true'\n    # The guard below cancels this run when its commit is superseded, which\n    # needs write access to the Actions API (issue #112 follow-up).\n    permissions:\n      contents: read\n      actions: write\n[\"cancelled\",[[\"pr-tests / pr-test / version-policy\",\"completed\",\"success\"],[\"pr-tests / pr-test / js\",\"completed\",\"cancelled\"],[\"pr-tests / pr-test / essentials\",\"completed\",\"cancelled\"],[\"pr-tests / pr-test / dind-${{ matrix.variant }}\",\"completed\",\"cancelled\"],[\"pr-tests / pr-test / ${{ matrix.language }}\",\"completed\",\"cancelled\"],[\"pr-tests / pr-test / full\",\"completed\",\"cancelled\"],[\"pr-tests / docker-build-test\",\"completed\",\"cancelled\"]]]\n[\"success\",[[\"pr-tests / pr-test / version-policy\",\"completed\",\"success\"],[\"pr-tests / pr-test / js\",\"completed\",\"skipped\"],[\"pr-tests / pr-test / essentials\",\"completed\",\"skipped\"],[\"pr-tests / pr-test / ${{ matrix.language }}\",\"completed\",\"skipped\"],[\"pr-tests / pr-test / dind-${{ matrix.variant }}\",\"completed\",\"skipped\"],[\"pr-tests / docker-build-test\",\"completed\",\"skipped\"],[\"pr-tests / pr-test / full\",\"completed\",\"skipped\"]]]\n","exit_code":0,"status":"completed"}}
