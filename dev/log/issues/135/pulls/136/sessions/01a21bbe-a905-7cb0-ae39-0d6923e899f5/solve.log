sh\nexperiments/test-issue121-pipeline-status-gate.sh\nexperiments/test-issue121-git-init-hint.sh\nexperiments/test-lino-parse.mjs\nexperiments/reproduce-issue121-push-rejection-texts.sh\nexperiments/verify-full-box-tooling.sh\nexperiments/test-issue115-heredoc-extraction.sh\nexperiments/test-issue123-pr-diff-range.sh\nexperiments/test-issue121-py-syntax.sh\nexperiments/issue-121-template-recheck/reproduce-all-recovered-false-negative.sh\nexperiments/test-issue123-log-command-injection.sh\nexperiments/test-issue121-git-hooks.sh\nexperiments/test-issue121-playwright-deps.sh\nexperiments/test-issue123-sigpipe-writers.sh\nexperiments/test-issue123-release-version.sh\nexperiments/test-issue108-detect-changes.sh\nexperiments/test-issue117-registry-probe.sh\nexperiments/test-issue121-workflow-audit-scope.sh\nexperiments/test-issue131-links-recheck.sh\nexperiments/test-sed-fix.sh\nexperiments/test-issue117-preflight-gating.sh\nexperiments/test-rankings-separately.mjs\nexperiments/test-issue112-supersede.sh\nexperiments/issue-123/repro-budget-privileged-child-inner.sh\nexperiments/issue-123/measure-npm-force.sh\nexperiments/issue-123/probe-shallow-base-ref.sh\nexperiments/issue-123/repro-supersede.sh\nexperiments/issue-123/render-upstream-reports.sh\nexperiments/issue-123/repro-dispatch-description-injection.sh\nexperiments/issue-123/repro-changeset-validation-fallback.sh\nexperiments/issue-123/collect-ci-evidence.mjs\nexperiments/issue-123/repro-log-injection-changeset.sh\nexperiments/issue-123/census-warnings-errors.sh\nexperiments/issue-123/snapshot-templates.sh\nexperiments/issue-123/repro-workdir-skips-skel.sh\nexperiments/issue-123/repro-budget-survivor.sh\nexperiments/issue-123/repro-sigpipe-ignored.sh\nexperiments/issue-123/compare-template-roles.sh\nexperiments/issue-123/repro-apt-retries-key.sh\nexperiments/issue-123/measure-apt-retry-timing.sh\nexperiments/issue-123/repro-version-gate-silent-pass.sh\nexperiments/issue-123/repro-csharp-exec-escaping.sh\nexperiments/issue-123/file-upstream-reports.sh\nexperiments/issue-123/repro-budget-privileged-child.sh\nexperiments/test-issue119-image-tags.sh\nexperiments/test-issue82-dockerhub-login-tolerance.sh\nexperiments/test-issue123-zizmor-token.sh\nexperiments/reproduce-issue121-actionlint-version-gap.sh\nexperiments/verify-script-syntax.sh\nexperiments/test-issue115-language-coverage.sh\nexperiments/test-issue115-elan-toolchain.sh\nexperiments/test-issue123-workflow-yaml.sh\nexperiments/test-issue131-live-restore.sh\nexperiments/test-issue115-shfmt-gate.sh\nexperiments/test-issue115-release-notes.sh\nexperiments/test-issue115-ci-policy.sh\nexperiments/test-json-manipulation.sh\nexperiments/test-issue133-stale-pid-files.sh\nname: Links\n\n# Ported from the template's links.yml (issue #115, R3/R5; hive-mind principle\n# #12, \"documentation validation\"). Nothing in this repository had ever checked\n# a URL. Reproduced against the tree as it was at 024dd6a, the run reports 113\n# failures over 16 files (107 distinct URLs, log in\n# dev/log/issues/115/pulls/116/logs/lychee-baseline-024dd6a.log): 85 GHCR\n# package pages the README advertised for images that have never been pushed,\n# 14 relative links to files that are not there - CI logs GitHub's 90-day\n# retention had already removed, and paths off by one `../` - three dead\n# upstream URLs, and a handful of hosts that answer a link checker with 429,\n# 503 or a TLS handshake failure.\n#\n# Reproduce locally with the same image and the same arguments:\n#\n#   docker run --rm -v \"$PWD:[REDACTED]\" -w /repo lycheeverse/lychee:0.24.2 \\\n#     --no-progress --include-fragments --max-retries 2 --timeout 30 \\\n#     --exclude-path dev/log './**/*.md'\n#\n# dev/log/ is excluded because it holds verbatim copies of other projects'\n# documentation, collected as issue evidence; their links are not ours to fix.\n# Known false positives - login-gated pages, rate-limiting hosts - are in\n# .lycheeignore, each with the reason it is there.\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - '**.md'\n      - '.lycheeignore'\n      - '.github/workflows/links.yml'\n      - 'scripts/ci/check-web-archive.mjs'\n      - 'scripts/ci/recheck-broken-links.mjs'\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      - '**.md'\n      - '.lycheeignore'\n      - '.github/workflows/links.yml'\n      - 'scripts/ci/check-web-archive.mjs'\n      - 'scripts/ci/recheck-broken-links.mjs'\n  # Weekly: a link rots without anyone touching this repository. The three dead\n  # upstream URLs this port found had all been correct when they were written.\n  schedule:\n    - cron: '0 6 * * 2'\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nenv:\n  # actions/checkout's first act is `git init`, and a git with no configured\n  # `init.defaultBranch` answers it with a thirteen-line advice block - \"Using\n  # 'master' as the name for the initial branch... this default branch name will\n  # change\" - at the top of every job log. 19 checkouts in the runs issue #121\n  # lists printed 247 lines of it, in jobs where nothing was wrong. No step can\n  # fix it, because it is printed before the first step of ours runs; git reads\n  # configuration from the environment too, and the environment is there from\n  # the start. Ported from the js template, which carries the same three lines\n  # with the same reasoning.\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  link-checker:\n    name: links / lychee\n    runs-on: ubuntu-24.04\n    # A full run is ~10s cached, ~30s cold. 10 minutes is the ceiling that stops\n    # one slow external host from holding a runner.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-link-checker\n      cancel-in-progress: true\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      # A `uses:` step takes the budget GitHub applies to a whole step, since it\n      # cannot be routed through scripts/ci/run-with-budget-warning.sh (issue\n      # #121, docs/CI-TIMEOUT-BUDGETS.md). The slowest run measured took 30\n      # seconds; 5 minutes bounds a slow external host without waiting for the\n      # job cap, which would report the job *cancelled* and skip the reporting\n      # steps below - including the recovery pass that tells a false positive\n      # from a real broken link.\n      #\n      # --include-fragments: without it lychee resolves a link's *document* and\n      # stops, so `docs/RELEASING.md#making-the-ghcr-packages-public` passes as\n      # long as the file exists, whatever the headings inside it say - and an\n      # anchor is exactly the part of a link that a heading rename breaks. This\n      # gate had never checked one (issue #121). Measured on this tree: a\n      # fixture that renames the target heading of a same-file and a cross-file\n      # anchor passes without the flag and fails with it; over the whole corpus\n      # the flag reports 681 links, 473 unique, 667 OK, 0 errors in 14.6s, after\n      # the three genuinely dead remote anchors it found were fixed (docker's\n      # #entrypoint-default-command-to-execute-at-runtime, jpetazzo/dind's\n      # #warning-..., and a GitHub docs page that moved). Evidence:\n      # dev/log/issues/121/pulls/122/doc-fragments/. It applies to remote\n      # anchors too, which is why the number of requests does not change: lychee\n      # already fetched those pages, it just discarded their ids.\n      - name: Check links with lychee\n        id: lychee\n        timeout-minutes: 5\n        uses: lycheeverse/lychee-action@v2\n        with:\n          args: >-\n            --no-progress\n            --cache\n            --max-cache-age 1d\n            --include-fragments\n            --max-retries 2\n            --timeout 30\n            --exclude-path dev/log\n            './**/*.md'\n          # Not a failure yet: a broken link that the Wayback Machine has\n          # archived gets a concrete replacement suggested below, which is more\n          # use to the author than a bare red X.\n          fail: false\n          output: lychee/out.md\n          jobSummary: true\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Set up Node\n        if: steps.lychee.outputs.exit_code != 0\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24'\n\n      # lychee classifies an error by the phase it happened in, and a failure\n      # during connect is never retried - `--max-retries` does not apply to it\n      # (lycheeverse/lychee#2297). So a healthy host that answers one TCP reset,\n      # which a CI address range collects from rate-limiting and load-shedding\n      # hosts, is reported broken without a single retry and fails this gate:\n      # a false positive (issue #121). Ask those URLs again, outside lychee. A\n      # temporary HTTP error (408, 429, 500, 502, 503 or 504) can also recover:\n      # PR #132 failed on two healthy GitHub docs links answering 503. Retry\n      # those within the same wall-clock budget; only an accepted status can\n      # recover them. Permanent failures such as 404 remain final. URLs with\n      # fragments stay final because the recovery's HEAD cannot check anchors.\n      - name: Re-check unanswered links and temporary HTTP errors\n        if: steps.lychee.outputs.exit_code != 0\n        id: recheck\n        run: node scripts/ci/recheck-broken-links.mjs\n        env:\n          LYCHEE_OUTPUT: lychee/out.md\n          RECOVERED_OUTPUT: lychee/recovered.txt\n\n      # `!= 'true'`, never `== 'false'`: a skipped or crashed re-check leaves\n      # the output empty, and only the `!=` form reads that as \"still failing\".\n      - name: Look for Web Archive replacements\n        if: >-\n          steps.lychee.outputs.exit_code != 0 &&\n          steps.recheck.outputs.all_recovered != 'true'\n        run: node scripts/ci/check-web-archive.mjs\n        env:\n          LYCHEE_OUTPUT: lychee/out.md\n          RECOVERED_URLS: lychee/recovered.txt\n\n      - name: Fail if broken links were found\n        if: >-\n          ${{ !cancelled() && steps.lychee.outputs.exit_code != 0 &&\n          steps.recheck.outputs.all_recovered != 'true' }}\n        run: |\n          echo \"::error title=links::lychee found broken links.\"\n          echo\n          echo \"An archive URL is a suggested replacement; it does not make the\"\n          echo \"live link valid. For each broken link, in order of preference:\"\n          echo \"  1. Point at the current location of the same content.\"\n          echo \"  2. Point at the archive.org snapshot suggested above.\"\n          echo \"  3. Pin a GitHub link to the commit that still holds the file.\"\n          echo \"  4. Delete the link if the content is gone and not worth citing.\"\n          echo \"  5. Add the URL to .lycheeignore *with a reason* - but only if\"\n          echo \"     the link is correct and merely unverifiable (login-gated,\"\n          echo \"     rate-limited, bot-blocked). A dead link is not a false\"\n          echo \"     positive, and silencing it is the defect issue #115 is about.\"\n          echo\n          echo \"Reproduce locally:\"\n          echo \"  docker run --rm -v \\\"\\$PWD:[REDACTED]\\\" -w /repo lycheeverse/lychee:0.24.2 \\\\\"\n          echo \"    --no-progress --include-fragments --max-retries 2 --timeout 30 \\\\\"\n          echo \"    --exclude-path dev/log './**/*.md'\"\n          exit 1\n\n      - name: The gate's own fixtures still hold\n        if: ${{ !cancelled() }}\n        run: bash experiments/test-issue115-links-gate.sh\n\n  # === TERMINAL STATUS GATE ===\n  #\n  # The job that makes every other job's result reach the run's conclusion\n  # (issue #121, reference-template best practice \"every workflow gets a\n  # terminal status gate\").\n  #\n  # GitHub derives a run's conclusion from its jobs, and one cancellation\n  # outranks any number of failures - so a run holding a failed job can still\n  # come out grey, and everything that reads the run rather than each job (the\n  # badge, `gh run list`, the run list quoted in issue #121 itself) reads that\n  # as \"no verdict\" rather than \"something broke\". A gate's own conclusion is a\n  # job conclusion, so when it errors the run is red no matter what else was\n  # cancelled. The rationale, the measured run and the supersede-versus-overrun\n  # rule are in scripts/ci/check-pipeline-status.sh.\n  #\n  # `!cancelled()`, not `always()`: cancelling a whole run is somebody's\n  # decision and repainting it red would be a false positive, so this job is\n  # skipped there. `cancelled()` is run-level, so a job cancelled on its own -\n  # an overrun, or a per-job concurrency group firing - still reaches the gate.\n  #\n  # `needs` must name every other job in this file, or a job's result cannot\n  # reach here at all. That is not left to review:\n  # scripts/ci/check-status-gate-covers-all-jobs.mjs derives the list from this\n  # workflow and fails when the two disagree.\n  pipeline-status:\n    name: pipeline-status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    needs: [link-checker]\n    if: ${{ !cancelled() }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # Anonymous `git ls-remote` is enough to resolve the branch head, which is\n      # how the script tells a superseded run from an overrun; no token is\n      # persisted for it.\n      - name: Check pipeline status\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          BRANCH_NAME: ${{ github.head_ref || github.ref_name }}\n        run: bash scripts/ci/check-pipeline-status.sh\nname: Measure Disk Space and Update README\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - 'scripts/ubuntu-24-server-install.sh'\n      - 'scripts/measure-disk-space.sh'\n      - 'scripts/update-readme-sizes.sh'\n      - 'Dockerfile'\n      - '.github/workflows/measure-disk-space.yml'\n  # The measurement itself takes ~3 hours and pushes to main, so it cannot run\n  # on a pull request. What CAN run on a pull request is everything that decides\n  # whether the measurement is going to work at all — and it has to, because\n  # this workflow only ever ran after the merge. Run 33972074753 (main, commit\n  # 42be663) is the case in point: `NODE_MAJOR: unbound variable` was\n  # introduced, reviewed and merged without a single job ever executing the\n  # changed script (issue #115).\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      - 'scripts/ubuntu-24-server-install.sh'\n      - 'scripts/measure-disk-space.sh'\n      - 'scripts/update-readme-sizes.sh'\n      - 'ubuntu/24.04/common.sh'\n      - 'data/disk-space-measurements.json'\n      - '.github/workflows/measure-disk-space.yml'\n      # The preflight and validation jobs, which are what a pull request can\n      # run here, are the only place these three are executed at all. They are\n      # deliberately absent from the push filter above: editing a validator\n      # should re-run the validation, not spend three hours measuring disk.\n      - 'scripts/ci/extract-quoted-heredoc.sh'\n      - 'scripts/ci/validate-measurements.py'\n      - 'scripts/ci/summarize-measurements.py'\n  # Allow manual trigger\n  workflow_dispatch:\n    inputs:\n      force_update:\n        description: 'Force update README even if no changes detected'\n        required: false\n        type: boolean\n        default: false\n      verbose:\n        description: 'Trace what the measurement script resolves, generates and hands to the box user (BOX_VERBOSE=1)'\n        required: false\n        type: boolean\n        default: false\n\n# Least-privilege default; the measurement job escalates to `contents: write`\n# for its push. The validation job never needs more than a read.\npermissions:\n  contents: read\n\nenv:\n  # actions/checkout's first act is `git init`, and a git with no configured\n  # `init.defaultBranch` answers it with a thirteen-line advice block - \"Using\n  # 'master' as the name for the initial branch... this default branch name will\n  # change\" - at the top of every job log. 19 checkouts in the runs issue #121\n  # lists printed 247 lines of it, in jobs where nothing was wrong. No step can\n  # fix it, because it is printed before the first step of ours runs; git reads\n  # configuration from the environment too, and the environment is there from\n  # the start. Ported from the js template, which carries the same three lines\n  # with the same reasoning.\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # Fast pre-merge gate. Nothing here installs anything, so it finishes in\n  # under a minute and can run on every pull request that touches the scripts.\n  validate:\n    name: Validate measurement scripts\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-validate\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      - name: Syntax-check the scripts\n        run: |\n          for f in scripts/measure-disk-space.sh scripts/ubuntu-24-server-install.sh scripts/update-readme-sizes.sh; do\n            echo \"bash -n $f\"\n            bash -n \"$f\"\n          done\n\n      # The generated script is written from a quoted heredoc, so `bash -n` on\n      # the parent says nothing about it. Extract it and check it separately.\n      #\n      # The extraction used to be an inline awk pattern that hardcoded the\n      # spacing of the opener (`cat > /tmp/box-measure.sh <<`). shfmt then\n      # reformatted the script to `cat >/tmp/box-measure.sh <<'EOF_BOX'` and the\n      # pattern matched nothing, failing this job on every push (issue #115,\n      # RC-22). The extraction now matches what bash parses rather than how the\n      # line happens to be formatted, and says which of \"no opener\", \"no\n      # terminator\" and \"empty body\" it hit.\n      - name: Syntax-check the generated box-user script\n        run: |\n          bash scripts/ci/extract-quoted-heredoc.sh \\\n            scripts/measure-disk-space.sh EOF_BOX > /tmp/generated-measure.sh\n          echo \"extracted $(wc -l < /tmp/generated-measure.sh) lines\"\n          bash -n /tmp/generated-measure.sh\n\n      - name: Check for variables leaking out of quoted heredocs\n        run: bash scripts/ci/check-heredoc-vars.sh\n\n      - name: Regression tests for issue #115\n        run: bash experiments/test-issue115-heredoc-unbound-vars.sh\n\n      # Argument handling is the other half of what broke: the documented\n      # no-argument invocation used to abort on `$1: unbound variable`.\n      - name: Check the command line interface\n        run: |\n          ./scripts/measure-disk-space.sh --help > /dev/null\n          if ./scripts/measure-disk-space.sh --not-an-option 2>/dev/null; then\n            echo \"::error::an unknown option must be rejected\"; exit 1\n          fi\n\n      # The committed measurements feed the README table; a malformed file\n      # would only be noticed three hours into the next measurement run.\n      - name: Validate the committed measurements\n        run: python3 scripts/ci/validate-measurements.py data/disk-space-measurements.json\n\n  measure-disk-space:\n    name: Measure Component Disk Space\n    # Pull requests stop at `validate`; measuring installs every toolchain on a\n    # bare runner and ends in a push to main.\n    if: github.event_name != 'pull_request'\n    runs-on: ubuntu-24.04\n    # 180 was \"3 hours max for full installation measurement\" - a number nobody\n    # had checked against a run. Every successful run of this job in the\n    # repository's history finished inside 23.3 minutes, the slowest of them in\n    # February (dev/log/issues/121/pulls/122/analysis/); 60 leaves more than\n    # twice that and still bounds a hang at an hour instead of three (issue\n    # #121, docs/CI-TIMEOUT-BUDGETS.md).\n    timeout-minutes: 60\n    # This job commits to main. Cancelling it mid-`git push` is worse than\n    # letting a superseded run finish, so it queues instead of cancelling —\n    # unlike the pre-merge checks above.\n    concurrency:\n      group: measure-disk-space-${{ github.ref }}\n      cancel-in-progress: false\n\n    # pull-requests: write is for the fallback path in\n    # scripts/release/git-push-with-retry.sh only (issue #121).\n    permissions:\n      contents: write\n      pull-requests: write\n\n    env:\n      # Off by default. `workflow_dispatch` can turn it on without editing the\n      # workflow, which is the whole point of having it (issue #115).\n      BOX_VERBOSE: ${{ inputs.verbose && '1' || '0' }}\n\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Kept, unlike every other checkout here: this job commits the\n          # measured table back to main, so the push needs the credential\n          # checkout leaves in .git/config. Stated rather than left to the\n          # default, so the one job that needs it is the one that says so.\n          persist-credentials: true\n          fetch-depth: 0\n          token: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Free up disk space\n        run: |\n          echo \"=== Initial disk space ===\"\n          df -h /\n\n          echo \"\"\n          echo \"=== Freeing up disk space ===\"\n\n          # Remove large directories that won't affect apt functionality\n          # NOTE: We intentionally do NOT run apt-get remove/autoremove as it breaks\n          # package installation. See docs/case-studies/issue-29 for details.\n          sudo rm -rf /usr/share/dotnet\n          sudo rm -rf /usr/local/lib/android\n          sudo rm -rf /opt/ghc\n          sudo rm -rf /opt/hostedtoolcache\n          sudo rm -rf /usr/local/share/boost\n          sudo rm -rf \"$AGENT_TOOLSDIRECTORY\"\n\n          # Refresh apt cache to ensure all packages are available\n          source ubuntu/24.04/common.sh\n          apt_update_with_retry\n\n          echo \"\"\n          echo \"=== Disk space after cleanup ===\"\n          df -h /\n\n      - name: Create data directory\n        run: mkdir -p data\n\n      - name: Run disk space measurement\n        id: measure\n        run: |\n          set -o pipefail\n          echo \"=== Starting disk space measurement ===\"\n\n          # Make script executable\n          chmod +x scripts/measure-disk-space.sh\n\n          # sudo resets the environment (env_reset), so BOX_VERBOSE has to be\n          # handed over explicitly rather than merely exported here.\n          # pipefail ensures script failures propagate through tee.\n          # The budget wraps the measurement, not the pipeline: `tee` has to\n          # stay outside it so the log survives an overrun, and `pipefail` above\n          # still carries the wrapper's exit status - 124 when it runs out of\n          # budget (issue #121, docs/CI-TIMEOUT-BUDGETS.md).\n          bash scripts/ci/run-with-budget-warning.sh 2400 \"disk space measurement\" \\\n            sudo env \"BOX_VERBOSE=$BOX_VERBOSE\" ./scripts/measure-disk-space.sh \\\n            --json-output data/disk-space-measurements.json 2>&1 | tee measurement.log\n\n          echo \"=== Measurement complete ===\"\n\n          # Check if JSON was created\n          if [ -f data/disk-space-measurements.json ]; then\n            echo \"json_created=true\" >> \"$GITHUB_OUTPUT\"\n            echo \"\"\n            echo \"=== Measurements JSON ===\"\n            cat data/disk-space-measurements.json\n          else\n            echo \"json_created=false\" >> \"$GITHUB_OUTPUT\"\n            echo \"::error::JSON file was not created\"\n            exit 1\n          fi\n\n      - name: Update README with component sizes\n        if: steps.measure.outputs.json_created == 'true'\n        env:\n          JSON_FILE: data/disk-space-measurements.json\n          README_FILE: README.md\n        run: |\n          chmod +x scripts/update-readme-sizes.sh\n          ./scripts/update-readme-sizes.sh\n\n          echo \"\"\n          echo \"=== Updated README section ===\"\n          sed -n '/<!-- COMPONENT_SIZES_START -->/,/<!-- COMPONENT_SIZES_END -->/p' README.md || echo \"No markers found in README\"\n\n      - name: Check for changes\n        id: changes\n        run: |\n          if git diff --quiet README.md data/disk-space-measurements.json 2>/dev/null; then\n            echo \"has_changes=false\" >> \"$GITHUB_OUTPUT\"\n            echo \"No changes detected\"\n          else\n            echo \"has_changes=true\" >> \"$GITHUB_OUTPUT\"\n            echo \"Changes detected:\"\n            git diff --stat README.md data/disk-space-measurements.json 2>/dev/null || true\n          fi\n\n      # The thresholds used to be compared with `[ -lt ]`, but total_size_mb is\n      # a float (\"7286.0\"), so that test never once evaluated: bash printed\n      # \"integer expression expected\", returned 2, and the `||` fell through to\n      # \"valid\". A measurement reporting 5 MB with a plausible component count\n      # would have been committed as good. The checks live in a script now, so\n      # they are testable and shared with the pull request gate (issue #115).\n      #\n      # `if ... then valid=true else valid=false` was wrong in the same way the\n      # `[ -lt ]` test was, one level up: the validator documents 0 = valid,\n      # 1 = invalid, 2 = usage error, and argparse exits 2 as well - so a\n      # SyntaxError, a renamed flag or a missing file all read as \"these\n      # measurements are invalid\" and quietly threw away three hours of work\n      # with the job green (issue #121). Only 1 means invalid. Anything else\n      # means the question was not answered, which is an error, not a verdict.\n      - name: Validate measurements\n        id: validate\n        run: |\n          set +e\n          python3 scripts/ci/validate-measurements.py data/disk-space-measurements.json\n          rc=$?\n          set -e\n          case \"$rc\" in\n            0)\n              echo \"valid=true\" >> \"$GITHUB_OUTPUT\"\n              ;;\n            1)\n              echo \"valid=false\" >> \"$GITHUB_OUTPUT\"\n              echo \"::warning::The measurements are invalid; nothing will be committed.\"\n              ;;\n            *)\n              echo \"::error title=Measurement validation could not run::validate-measurements.py exited $rc, which is neither valid (0) nor invalid (1). The measurement is not being discarded on the strength of an answer nobody got.\"\n              exit 1\n              ;;\n          esac\n\n      - name: Commit and push changes\n        if: steps.changes.outputs.has_changes == 'true' && steps.validate.outputs.valid == 'true'\n        env:\n          # Only read on the fallback path, when a repository rule declines the\n          # direct push and the commit has to arrive as a pull request.\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n\n          git add README.md data/disk-space-measurements.json\n\n          # Create commit message with summary\n          TOTAL_SIZE=$(python3 -c \"import json; print(json.load(open('data/disk-space-measurements.json'))['total_size_mb'])\" 2>/dev/null || echo \"unknown\")\n\n          # Guarded like every other commit in this repository: the subject is\n          # generated here, but the diffstat and file list git prints with it\n          # are not, and one exception is how the invariant stops holding\n          # (issue #123).\n          bash scripts/ci/run-with-commands-stopped.sh git commit -m \"chore: update component disk space measurements (${TOTAL_SIZE}MB total)\"\n\n          # This job runs for about 18 minutes before it pushes, which is a wide\n          # window for the release workflow to land a version bump. A single\n          # pull-rebase closes most of it but not the seconds between the\n          # rebase and the push, and it never retries; the helper rebases and\n          # retries, and answers a repository-rule rejection with a pull\n          # request rather than a rebase that cannot satisfy it (issue #121,\n          # and see docs/case-studies/issue-51 for the original race).\n          # Measurement data (README.md, data/) and version bumps (VERSION)\n          # touch different files, so the rebase resolves cleanly.\n          bash scripts/release/git-push-with-retry.sh origin main \"disk-space-measurements\"\n\n          echo \"Changes committed and pushed successfully\"\n\n      # Deliberately NOT gated on has_changes. It used to be, which meant a\n      # measurement that was invalid AND identical to the committed one passed\n      # the workflow silently — the failure mode that keeps a broken number in\n      # the README for as long as it stays broken.\n      - name: Fail on invalid measurements\n        if: steps.validate.outputs.valid != 'true'\n        run: |\n          echo \"::error::Invalid measurements detected. Not committing to prevent data corruption.\"\n          echo \"Please investigate the measurement logs and fix the underlying issue.\"\n          exit 1\n\n      # Always upload, especially on failure: measurement.log is the only record\n      # of what the three-hour run did, and a plain step without `if:` is\n      # skipped as soon as anything above it fails — which is exactly when the\n      # log is wanted (issue #115).\n      #\n      # And require it, rather than warning about its absence. `warn` made the\n      # one thing that must not happen — the only record of the run not being\n      # kept — into a line in the log of the run whose record is missing. The\n      # reason it was `warn` is that `!cancelled()` also holds when the job\n      # failed before the measurement, so the upload is gated on the measuring\n      # step having run instead: `tee measurement.log` above creates the file\n      # the moment that step starts, so from then on at least one of these two\n      # paths exists and an empty match means the evidence was lost. Written in\n      # the positive form because the `steps` context holds only steps that\n      # \"have an `id` specified and have already run\" (GitHub, \"Contexts\"), so a\n      # step that never started has no entry and `!= 'skipped'` would be true of\n      # that empty value (issue #123).\n      - name: Upload measurement artifacts\n        if: ${{ !cancelled() && (steps.measure.outcome == 'success' || steps.measure.outcome == 'failure') }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: disk-space-measurements\n          path: |\n            data/disk-space-measurements.json\n            measurement.log\n          retention-days: 30\n          if-no-files-found: error\n\n      - name: Summary\n        if: ${{ !cancelled() }}\n        run: |\n          {\n            echo \"## Disk Space Measurement Results\"\n            echo \"\"\n          } >> \"$GITHUB_STEP_SUMMARY\"\n\n          if [ -f data/disk-space-measurements.json ]; then\n            python3 scripts/ci/summarize-measurements.py data/disk-space-measurements.json >> \"$GITHUB_STEP_SUMMARY\"\n          else\n            echo \"Measurement JSON not found\" >> \"$GITHUB_STEP_SUMMARY\"\n          fi\n\n  # === TERMINAL STATUS GATE ===\n  #\n  # The job that makes every other job's result reach the run's conclusion\n  # (issue #121, reference-template best practice \"every workflow gets a\n  # terminal status gate\").\n  #\n  # GitHub derives a run's conclusion from its jobs, and one cancellation\n  # outranks any number of failures - so a run holding a failed job can still\n  # come out grey, and everything that reads the run rather than each job (the\n  # badge, `gh run list`, the run list quoted in issue #121 itself) reads that\n  # as \"no verdict\" rather than \"something broke\". A gate's own conclusion is a\n  # job conclusion, so when it errors the run is red no matter what else was\n  # cancelled. The rationale, the measured run and the supersede-versus-overrun\n  # rule are in scripts/ci/check-pipeline-status.sh.\n  #\n  # `!cancelled()`, not `always()`: cancelling a whole run is somebody's\n  # decision and repainting it red would be a false positive, so this job is\n  # skipped there. `cancelled()` is run-level, so a job cancelled on its own -\n  # an overrun, or a per-job concurrency group firing - still reaches the gate.\n  #\n  # `needs` must name every other job in this file, or a job's result cannot\n  # reach here at all. That is not left to review:\n  # scripts/ci/check-status-gate-covers-all-jobs.mjs derives the list from this\n  # workflow and fails when the two disagree.\n  pipeline-status:\n    name: pipeline-status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    needs: [validate, measure-disk-space]\n    if: ${{ !cancelled() }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # Anonymous `git ls-remote` is enough to resolve the branch head, which is\n      # how the script tells a superseded run from an overrun; no token is\n      # persisted for it.\n      - name: Check pipeline status\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          BRANCH_NAME: ${{ github.head_ref || github.ref_name }}\n        run: bash scripts/ci/check-pipeline-status.sh\nname: Scripts\n\n# Static checks over the shell scripts that build and measure the boxes.\n#\n# Why this workflow exists (issue #115): the two scripts that generate a second\n# script from a quoted heredoc both referenced parent-shell variables that the\n# generated script could never see. One of them broke `Measure Disk Space and\n# Update README` on main (run 33972074753); the other, scripts/ubuntu-24-server-install.sh,\n# had the identical defect and no job that would ever have run it. Checks that\n# only ever run on a developer's laptop are not checks, so they run here.\n#\n# The filters below are the union of what every gate in this file reads, not a\n# guess at it: the shell for shellcheck, shfmt and the heredoc scan; .githooks/\n# because git requires an extensionless `pre-commit`, which no `*.sh` glob ever\n# sees; the JavaScript for the syntax gate; and .mjs, .js, .py, .yml and .yaml\n# for the awk scan, which reads every language that can embed an awk program.\n# `scripts/ci/check-workflow-path-coverage.mjs` derives that requirement from\n# these lines and fails when a gate here reads a file none of them can match -\n# which is what the mjs-syntax job did for its entire first day (issue #121).\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - '**.sh'\n      - '**.bash'\n      - '**.mjs'\n      - '**.js'\n      - '**.py'\n      - '**.yml'\n      - '**.yaml'\n      - '.githooks/**'\n      - '.github/workflows/**'\n      - 'ubuntu/**'\n      - 'tests/**'\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      - '**.sh'\n      - '**.bash'\n      - '**.mjs'\n      - '**.js'\n      - '**.py'\n      - '**.yml'\n      - '**.yaml'\n      - '.githooks/**'\n      - '.github/workflows/**'\n      - 'ubuntu/**'\n      - 'tests/**'\n  workflow_dispatch:\n\n# Least-privilege default; these jobs only read the checked-out tree.\npermissions:\n  contents: read\n\nenv:\n  # actions/checkout's first act is `git init`, and a git with no configured\n  # `init.defaultBranch` answers it with a thirteen-line advice block - \"Using\n  # 'master' as the name for the initial branch... this default branch name will\n  # change\" - at the top of every job log. 19 checkouts in the runs issue #121\n  # lists printed 247 lines of it, in jobs where nothing was wrong. No step can\n  # fix it, because it is printed before the first step of ours runs; git reads\n  # configuration from the environment too, and the environment is there from\n  # the start. Ported from the js template, which carries the same three lines\n  # with the same reasoning.\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  heredoc-vars:\n    name: scripts / heredoc variables\n    runs-on: ubuntu-24.04\n    # Typical run: a few seconds. The limit is here so a pathological regex\n    # cannot hold a runner for six hours.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-heredoc-vars\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Nothing here pushes; leaving the token in .git/config would only\n          # widen what a compromised step could reach.\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      # Fails the job on any expansion inside a quoted heredoc that the\n      # generated script cannot resolve, with a file/line annotation.\n      - name: No variable leaks out of a quoted heredoc\n        run: bash scripts/ci/check-heredoc-vars.sh\n\n      # The checker is only worth trusting if its own false-positive and\n      # false-negative fixtures still hold.\n      - name: Checker fixtures and the run 33972074753 reproduction\n        run: bash experiments/test-issue115-heredoc-unbound-vars.sh\n\n  # Issue #121. `awk` on a GitHub ubuntu-24.04 runner is gawk; `awk` on Debian\n  # and Ubuntu generally - including the containers the rest of these jobs shell\n  # into - is mawk. A regex escape gawk implements and mawk does not (`\\s`, `\\w`,\n  # `\\<`) is not a syntax error under mawk: the pattern simply never matches, and\n  # nothing is printed. A check written that way passes everywhere it is silent.\n  #\n  # That is not hypothetical here. The suite asserting that no composite action\n  # interpolates a `${{ }}` expansion into a `run:` block extracted the block\n  # with `awk '/^\\s+run: \\|/,0'`, passed locally on mawk while reading nothing,\n  # and failed in CI on gawk - where `,0` then ran the range to end of file and\n  # reported `with:` mappings that were correct. Both halves are reproduced in\n  # experiments/reproduce-issue121-awk-run-block-range.sh.\n  #\n  # Reproduce a finding locally:\n  #   bash scripts/ci/check-awk-portability.sh --verbose\n  awk-portability:\n    name: scripts / awk portability\n    runs-on: ubuntu-24.04\n    # Typical run: under a second over ~40 files. The limit is a backstop.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-awk-portability\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Nothing here pushes; leaving the token in .git/config would only\n          # widen what a compromised step could reach.\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      # Fails the job on any GNU-only regex escape inside an awk program, with a\n      # file/line annotation.\n      - name: No awk program depends on a GNU-only regex escape\n        run: bash scripts/ci/check-awk-portability.sh\n\n      # The checker is only worth trusting if its own false-positive and\n      # false-negative fixtures still hold - and this one exists because a check\n      # that could not fail went unnoticed.\n      - name: Checker fixtures and the mawk/gawk reproduction\n        run: bash experiments/test-issue121-awk-portability.sh\n\n  # Issue #121. This repository is Dockerfiles and shell, so its JavaScript is\n  # easy to forget: ten of the fourteen tracked modules outside dev/log/ were\n  # named by no workflow and no suite, and nothing parsed them. Two of the four\n  # that are named only *execute* on the recovery path - links.yml runs\n  # recheck-broken-links.mjs after lychee has already failed - so a syntax error\n  # there would surface on the one run that needed it and on no run before.\n  # `node --check` is milliseconds a file; the js template gates on it, and\n  # experiments/reproduce-issue121-mjs-syntax-gap.sh measures the gap it closes.\n  mjs-syntax:\n    name: scripts / JavaScript syntax\n    runs-on: ubuntu-24.04\n    # Typical run: under two seconds over 16 modules. The limit is a backstop.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-mjs-syntax\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Nothing here pushes; leaving the token in .git/config would only\n          # widen what a compromised step could reach.\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      # No setup-node step: this uses the Node the runner image ships, the same\n      # as the `workflows` job's two .mjs checkers. A newer parser accepts more\n      # syntax, not less, so the drift a pinned version would prevent can only\n      # make this gate more permissive - never a false positive.\n      #\n      # Fails the job on a module that does not parse, or a relative import\n      # that resolves to nothing, with a file/line annotation.\n      - name: Every JavaScript module parses\n        run: bash scripts/ci/check-mjs-syntax.sh\n\n      # The checker is only worth trusting if its own false-positive and\n      # false-negative fixtures still hold.\n      - name: Checker fixtures and the coverage-gap reproduction\n        run: bash experiments/test-issue121-mjs-syntax.sh\n\n  # The same question asked of the Python, and it had the same answer: three\n  # tracked *.py files outside dev/log/, parsed by nothing (issue #121).\n  # shellcheck and shfmt take *.sh, run-experiments.sh discovers *.sh, and the\n  # pyflakes inside actionlint's image reads the `run:` blocks of workflows, not\n  # the files those blocks call. Two of the three decide what happens to a\n  # three-hour disk measurement - whether it is valid, and what the job summary\n  # says about it - so a SyntaxError in either would first be seen by the run\n  # that needed it.\n  py-syntax:\n    name: scripts / Python syntax\n    runs-on: ubuntu-24.04\n    # Typical run: well under a second over three files. The limit is a backstop.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-py-syntax\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Nothing here pushes; leaving the token in .git/config would only\n          # widen what a compromised step could reach.\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      # No setup-python step: this uses the Python the runner image ships, the\n      # same interpreter measure-disk-space.yml calls these files with. Pinning\n      # a different one would report on a version this repository never runs.\n      #\n      # Fails the job on a file that does not compile, with a file/line/column\n      # annotation.\n      - name: Every Python file parses\n        run: bash scripts/ci/check-py-syntax.sh\n\n      # The checker is only worth trusting if its own false-positive and\n      # false-negative fixtures still hold.\n      - name: Checker fixtures\n        run: bash experiments/test-issue121-py-syntax.sh\n\n  # Issue #115. actionlint runs shellcheck over the `run:` blocks inside\n  # .github/workflows/**, and nothing ran it over the 75 tracked *.sh files that\n  # actually build the boxes — the largest body of shell in the repository was\n  # the only one no linter saw. That is a false negative by construction: a\n  # `for x in $(ls ...)` in ubuntu/24.04/js/install.sh is exactly the class of\n  # defect shellcheck exists to catch, and four of them were sitting in the\n  # tree when this job was added.\n  #\n  # Threshold is --severity=warning, the same bar actionlint's bundled\n  # shellcheck applies to workflow `run:` blocks, so a snippet does not pass in\n  # one place and fail in the other. `info` and below are excluded on purpose:\n  # they are dominated by SC1091 (sourcing a path that only exists inside the\n  # image) and SC2016 (single-quoted `$` in the heredocs that generate the\n  # in-image scripts), both of which are deliberate here.\n  #\n  # Reproduce locally with the identical command:\n  #   bash scripts/ci/run-shellcheck.sh\n  shellcheck:\n    name: scripts / shellcheck\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-shellcheck\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      - name: shellcheck every tracked shell script\n        run: bash scripts/ci/run-shellcheck.sh\n\n      - name: The runner's own fixtures still hold\n        run: bash experiments/test-issue115-shellcheck-gate.sh\n\n  # Issue #115, template best practice #3 (\"automated code formatting\"). The\n  # template runs prettier over a JavaScript repository; the source of this one\n  # is shell, and nothing formatted it. 74 of the 98 tracked scripts disagreed\n  # with any single consistent style - four-space indents next to two-space\n  # ones, `a; b` on one line next to one statement per line - which makes every\n  # diff noisier than the change it carries and turns formatting into a review\n  # comment nobody should have to write.\n  #\n  # A reformat is nearly always inert - shfmt parses the script and prints the\n  # syntax tree back out - but \"nearly\" is doing work: shfmt formats an array\n  # subscript as arithmetic, and it silently rewrote the key\n  # `[node-lts-integration-test.sh]` in run-experiments.sh into a different\n  # string, disabling three skip entries. The regression suites caught it. So\n  # the evidence that a reformat is safe is that the suites pass over the\n  # rewritten tree, never the parse-and-print argument on its own.\n  #\n  # Reproduce locally with the identical command:\n  #   bash scripts/ci/run-shfmt.sh          # check\n  #   bash scripts/ci/run-shfmt.sh --fix    # rewrite\n  shfmt:\n    name: scripts / formatting\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-shfmt\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      - name: Every shell script is formatted\n        run: bash scripts/ci/run-shfmt.sh\n\n      # Including the check that the formatter cannot pass by examining\n      # nothing: a wrong mount or a missing tool exits 0 with no output, which\n      # is indistinguishable from a clean tree (RC-16).\n      - name: The formatter gate's own fixtures still hold\n        run: bash experiments/test-issue115-shfmt-gate.sh\n\n  # Issue #115 (RC-9). The repository had 27 regression suites under\n  # experiments/ and the workflows referenced 5 of them. The remaining 22 ran\n  # only when someone remembered to — so two of them had been crashing on any\n  # machine without a UTF-8 locale, unnoticed, because nothing ran them.\n  #\n  # The runner discovers suites instead of listing them, so a suite added in a\n  # later PR is gated from the moment it lands.\n  experiments:\n    name: scripts / regression suites\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-experiments\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      - name: List the suites that will run\n        run: bash scripts/ci/run-experiments.sh --list\n\n      # The budget belongs on this step, not on the job: `Upload suite logs`\n      # below runs `if: !cancelled()`, and a job killed by `timeout-minutes` is\n      # cancelled - so an overrun would take the logs that explain it with it\n      # (issue #121, docs/CI-TIMEOUT-BUDGETS.md). The slowest run measured took\n      # 106 seconds across all suites.\n      - name: Run every experiment suite\n        id: suites\n        run: |\n          bash scripts/ci/run-with-budget-warning.sh 600 \"every experiment suite\" \\\n            bash scripts/ci/run-experiments.sh\n\n      # `if-no-files-found: warn` cannot fail, so the one outcome this step\n      # exists to prevent - the evidence going missing - is the outcome it\n      # reports as a warning nobody reads. It was `warn` because the step also\n      # runs when the job failed early, and then there is legitimately nothing\n      # to upload.\n      #\n      # Ask the narrower question instead: upload only when the producing step\n      # actually ran, and require files when it did. run-experiments.sh:124-125\n      # creates $LOG_DIR before the first suite and :140 writes a log per suite,\n      # so once that step has an outcome of success or failure the directory\n      # exists and is non-empty - an empty upload then means the logs were lost,\n      # which is a failure. The condition is written in the positive form\n      # because the `steps` context holds only steps that \"have an `id`\n      # specified and have already run\" (GitHub, \"Contexts\"), so a step that\n      # never started has no entry and `!= 'skipped'` would be true of that\n      # empty value (issue #123).\n      - name: Upload suite logs\n        if: ${{ !cancelled() && (steps.suites.outcome == 'success' || steps.suites.outcome == 'failure') }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: experiment-logs\n          path: /tmp/experiment-logs/\n          if-no-files-found: error\n          retention-days: 7\n\n  # === TERMINAL STATUS GATE ===\n  #\n  # The job that makes every other job's result reach the run's conclusion\n  # (issue #121, reference-template best practice \"every workflow gets a\n  # terminal status gate\").\n  #\n  # GitHub derives a run's conclusion from its jobs, and one cancellation\n  # outranks any number of failures - so a run holding a failed job can still\n  # come out grey, and everything that reads the run rather than each job (the\n  # badge, `gh run list`, the run list quoted in issue #121 itself) reads that\n  # as \"no verdict\" rather than \"something broke\". A gate's own conclusion is a\n  # job conclusion, so when it errors the run is red no matter what else was\n  # cancelled. The rationale, the measured run and the supersede-versus-overrun\n  # rule are in scripts/ci/check-pipeline-status.sh.\n  #\n  # `!cancelled()`, not `always()`: cancelling a whole run is somebody's\n  # decision and repainting it red would be a false positive, so this job is\n  # skipped there. `cancelled()` is run-level, so a job cancelled on its own -\n  # an overrun, or a per-job concurrency group firing - still reaches the gate.\n  #\n  # `needs` must name every other job in this file, or a job's result cannot\n  # reach here at all. That is not left to review:\n  # scripts/ci/check-status-gate-covers-all-jobs.mjs derives the list from this\n  # workflow and fails when the two disagree.\n  pipeline-status:\n    name: pipeline-status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    needs: [heredoc-vars, awk-portability, mjs-syntax, py-syntax, shellcheck, shfmt, experiments]\n    if: ${{ !cancelled() }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # Anonymous `git ls-remote` is enough to resolve the branch head, which is\n      # how the script tells a superseded run from an overrun; no token is\n      # persisted for it.\n      - name: Check pipeline status\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          BRANCH_NAME: ${{ github.head_ref || github.ref_name }}\n        run: bash scripts/ci/check-pipeline-status.sh\nname: Workflows\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - '.github/workflows/**'\n      - '.github/actions/**'\n      - '.github/zizmor.yml'\n      # The gates below read the workflows, so editing one has to re-run it.\n      - 'scripts/ci/check-workflow-yaml.sh'\n      - 'scripts/ci/check-status-gate-covers-all-jobs.mjs'\n      - 'scripts/ci/check-timeout-budgets.mjs'\n      - 'scripts/ci/check-workflow-path-coverage.mjs'\n      - 'scripts/ci/check-checkout-credentials.mjs'\n      - 'scripts/ci/run-zizmor.sh'\n      - 'experiments/test-issue123-workflow-yaml.sh'\n      - 'experiments/test-issue121-path-coverage.sh'\n      - 'experiments/test-issue121-git-init-hint.sh'\n      - 'experiments/test-issue121-checkout-credentials.sh'\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      - '.github/workflows/**'\n      - '.github/actions/**'\n      - '.github/zizmor.yml'\n      # The gates below read the workflows, so editing one has to re-run it.\n      - 'scripts/ci/check-workflow-yaml.sh'\n      - 'scripts/ci/check-status-gate-covers-all-jobs.mjs'\n      - 'scripts/ci/check-timeout-budgets.mjs'\n      - 'scripts/ci/check-workflow-path-coverage.mjs'\n      - 'scripts/ci/check-checkout-credentials.mjs'\n      - 'scripts/ci/run-zizmor.sh'\n      - 'experiments/test-issue123-workflow-yaml.sh'\n      - 'experiments/test-issue121-path-coverage.sh'\n      - 'experiments/test-issue121-git-init-hint.sh'\n      - 'experiments/test-issue121-checkout-credentials.sh'\n  workflow_dispatch:\n\n# Least-privilege default; these jobs only read the checked-out tree.\npermissions:\n  contents: read\n\nenv:\n  # actions/checkout's first act is `git init`, and a git with no configured\n  # `init.defaultBranch` answers it with a thirteen-line advice block - \"Using\n  # 'master' as the name for the initial branch... this default branch name will\n  # change\" - at the top of every job log. 19 checkouts in the runs issue #121\n  # lists printed 247 lines of it, in jobs where nothing was wrong. No step can\n  # fix it, because it is printed before the first step of ours runs; git reads\n  # configuration from the environment too, and the environment is there from\n  # the start. Ported from the js template, which carries the same three lines\n  # with the same reasoning.\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  actionlint:\n    name: actionlint\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-actionlint\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      # The Docker image bundles shellcheck and pyflakes, so this also lints\n      # every `run:` block — which is the point here: release.yml carries\n      # thousands of lines of shell that no other linter sees. A native\n      # actionlint binary without shellcheck on PATH silently skips the shell\n      # checks and exits 0, so reproduce failures with the image:\n      #   docker run --rm -v \"$PWD:[REDACTED]\" -w /repo rhysd/actionlint:1.7.12 -color\n      #\n      # Pinned by digest, not by tag: a mutable tag of a repository we do not\n      # control is arbitrary code execution in any job that holds credentials,\n      # which is the `'*': hash-pin` policy this repository already declares in\n      # .github/zizmor.yml. Re-resolve when bumping:\n      #   docker pull rhysd/actionlint:<tag> &&\n      #   docker buildx imagetools inspect rhysd/actionlint:<tag>\n      #\n      # A digest pin also freezes the check set, which is why the version it\n      # resolves to is part of this gate rather than an implementation detail.\n      # v1.7.7 (2025-01-25) predates three checks that report exactly what this\n      # workflow exists to catch, a check that cannot fail:\n      #   * `glob`         - a `paths:` entry beginning with `./` matches\n      #                      nothing, so the workflow never starts (v1.7.11).\n      #   * `if-cond`      - `if: false` on a job that is still listed in the\n      #                      status gate's `needs` (v1.7.9, v1.7.10).\n      #   * `runner-label` - a label GitHub has removed, so the job never\n      #                      starts (v1.7.8, v1.7.10).\n      # Measured against fixtures for all three plus a YAML merge key, v1.7.7\n      # reports one finding and describes it wrongly; v1.7.12 reports four:\n      # experiments/reproduce-issue121-actionlint-version-gap.sh. Against this\n      # repository as it stands both are clean, so the bump costs nothing now\n      # and is the only thing here that can make those three findings - the\n      # coverage gate below cannot see a dead `paths:` entry that has a live\n      # sibling.\n      - uses: docker://rhysd/actionlint@sha256:b1934ee5f1c5096
[2026-11-27T06:44:11.291Z] [STDOUT] 18f2508e6eb47ee0d3520686341fec936f3b79331f9315667 # v1.7.12\n        with:\n          args: -color\n\n      # actionlint is the only thing above that reads these files as YAML, and it\n      # needs docker - so the pre-commit hook cannot run it, and an unparseable\n      # workflow was committable (issue #123). The three gates below read\n      # workflows line by line, which is right for the questions they ask and\n      # means none of them can tell a file they disagree with from a file no\n      # parser accepts: release-full.yml was not YAML and all three passed it.\n      # This establishes that floor offline, in milliseconds, for both.\n      - name: Every workflow and composite action parses as YAML\n        run: bash scripts/ci/check-workflow-yaml.sh\n\n      - name: The YAML gate's own fixtures still hold\n        run: bash experiments/test-issue123-workflow-yaml.sh\n\n      # actionlint validates a workflow's syntax; it cannot know that a job was\n      # left out of the terminal gate's `needs` and so cannot turn the run red\n      # (issue #121). That requirement is derived from each workflow rather than\n      # kept in a list, so adding a job to any file here fails this step until\n      # the gate names it.\n      - name: Every workflow's status gate covers every job in it\n        run: node scripts/ci/check-status-gate-covers-all-jobs.mjs .github/workflows/*.yml\n\n      # The same argument one level down (issue #121). A long step's execution\n      # budget only reports the overrun if it expires *before* the job's\n      # `timeout-minutes` backstop cancels the job; a budget that meets or\n      # exceeds its cap is a check that can never fire, and the run goes grey\n      # with no indication of which step ran long. This derives both numbers\n      # from the workflow and fails when a budget claims too much of its cap -\n      # per matrix leg, because this repository sizes caps and budgets per leg.\n      - name: Every execution budget fits inside its job's timeout\n        run: node scripts/ci/check-timeout-budgets.mjs .github/workflows/*.yml\n\n      # And one level up again (issue #121). A `paths:` filter is the cheapest\n      # way to build a check that cannot fail: the job exists, the gate works,\n      # its fixtures pass, and because the filter matches none of the files the\n      # gate reads, the pull request that breaks exactly what it was written for\n      # never starts it - nothing red, nothing skipped, just absent from the\n      # list. scripts.yml ran the JavaScript syntax gate under a filter of\n      # '**.sh', 'ubuntu/**' and 'tests/**' for a day. This asks, of every\n      # script a workflow runs, whether every file it reads can start a run.\n      - name: Every gate can be started by the files it reads\n        run: node scripts/ci/check-workflow-path-coverage.mjs\n\n      # The gate's own fixtures: throwaway repositories whose filters are known\n      # to cover or to miss, so a change to the pattern translation - GitHub's\n      # `*` stops at a slash and `**` does not - fails here rather than by\n      # quietly passing a repository it should have reported.\n      - name: Path-coverage fixtures\n        run: bash experiments/test-issue121-path-coverage.sh\n\n      # Every job log used to open with git's thirteen-line \"Using 'master' as\n      # the name for the initial branch\" advice, because actions/checkout runs\n      # `git init` before any step can configure it. The fix is three `env:`\n      # entries per workflow, and the thing that rots is the next workflow\n      # added without them - so this reads all of them, every time one changes.\n      - name: Git advice hints\n        run: bash experiments/test-issue121-git-init-hint.sh\n\n      # actions/checkout authenticates by writing the job's token into\n      # .git/config, and unless told otherwise leaves it there for every later\n      # step. Thirty of this repository's fifty-five checkouts said nothing, so\n      # thirty jobs kept it - `js / build-js-amd64` for 427 seconds while a\n      # docker build ran with the workspace as its context, against 1.1-2.1s in\n      # the jobs that had been hardened. zizmor audits this (`artipacked`) and\n      # ran on every one of them, but reports at severity Low and the job below\n      # floors at medium: filtered out thirty times (issue #121). This asks the\n      # narrower question the floor cannot - whether the setting *matches what\n      # the job does* - by following each job's run blocks into the scripts\n      # they call and looking for a push.\n      - name: Every checkout says what happens to the job token\n        run: node scripts/ci/check-checkout-credentials.mjs\n\n      - name: Checkout-credential fixtures\n        run: bash experiments/test-issue121-checkout-credentials.sh\n\n  zizmor:\n    name: zizmor\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-zizmor\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      # Both passes run through scripts/ci/run-zizmor.sh, which pins the image,\n      # the floors and the scan targets in one place, and - the reason it\n      # exists - hands zizmor a GitHub API token and fails the job if zizmor\n      # says it is running offline anyway.\n      #\n      # Since 1.0 zizmor is offline unless it has a token, and `docker run`\n      # forwards no environment, so the two invocations that used to live here\n      # ran with the online audits switched off. The run on 1d9fb3e logged\n      # `zizmor is running in offline mode by default; some audits and\n      # auto-fixes will not be available` twice and reported no findings - about\n      # a question it never asked, because `known-vulnerable-actions` needs the\n      # GitHub Advisory Database (issue #123).\n      #\n      # GH_TOKEN, not GITHUB_TOKEN, because that is the name zizmor reads first\n      # and the name the container is given. `contents: read` is all it needs;\n      # the advisory data is public.\n      - name: zizmor\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: bash scripts/ci/run-zizmor.sh regular\n\n      # The pass above runs zizmor's default `regular` persona, which is the\n      # right default: `pedantic` surfaces hundreds of stylistic findings. But\n      # the audits covering container image references — `unpinned-images`\n      # among them — are Pedantic-only, so the `'*': hash-pin` policy declared\n      # in .github/zizmor.yml was never enforced against `uses: docker://` or\n      # `container:` at all: a policy the CI could not apply (issue #121).\n      # Narrowing this second pass to high severity *and* high confidence\n      # restores the enforcement without importing the noise. Measured: after\n      # the digest pin above it reports nothing, and stays silent until someone\n      # reintroduces a mutable image reference.\n      - name: Audit for pedantic-only high-severity findings\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: bash scripts/ci/run-zizmor.sh pedantic\n\n  # === TERMINAL STATUS GATE ===\n  #\n  # The job that makes every other job's result reach the run's conclusion\n  # (issue #121, reference-template best practice \"every workflow gets a\n  # terminal status gate\").\n  #\n  # GitHub derives a run's conclusion from its jobs, and one cancellation\n  # outranks any number of failures - so a run holding a failed job can still\n  # come out grey, and everything that reads the run rather than each job (the\n  # badge, `gh run list`, the run list quoted in issue #121 itself) reads that\n  # as \"no verdict\" rather than \"something broke\". A gate's own conclusion is a\n  # job conclusion, so when it errors the run is red no matter what else was\n  # cancelled. The rationale, the measured run and the supersede-versus-overrun\n  # rule are in scripts/ci/check-pipeline-status.sh.\n  #\n  # `!cancelled()`, not `always()`: cancelling a whole run is somebody's\n  # decision and repainting it red would be a false positive, so this job is\n  # skipped there. `cancelled()` is run-level, so a job cancelled on its own -\n  # an overrun, or a per-job concurrency group firing - still reaches the gate.\n  #\n  # `needs` must name every other job in this file, or a job's result cannot\n  # reach here at all. That is not left to review:\n  # scripts/ci/check-status-gate-covers-all-jobs.mjs derives the list from this\n  # workflow and fails when the two disagree.\n  pipeline-status:\n    name: pipeline-status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    needs: [actionlint, zizmor]\n    if: ${{ !cancelled() }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # Anonymous `git ls-remote` is enough to resolve the branch head, which is\n      # how the script tells a superseded run from an overrun; no token is\n      # persisted for it.\n      - name: Check pipeline status\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          BRANCH_NAME: ${{ github.head_ref || github.ref_name }}\n        run: bash scripts/ci/check-pipeline-status.sh\nname: Dockerfiles\n\n# Static checks over the Dockerfiles that define the boxes.\n#\n# Why this workflow exists (issue #115): this repository *is* a collection of\n# Dockerfiles, and no linter had ever read one. actionlint reads the workflows,\n# scripts.yml reads every *.sh, and the 23 Dockerfiles were the one body of\n# source with no check at all. `apt install` instead of `apt-get install` was\n# sitting in ubuntu/24.04/js/Dockerfile and in nine install scripts, printing\n# \"WARNING: apt does not have a stable CLI interface\" into every box build -\n# a warning nobody was looking for, because nothing collected it.\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      # A GitHub filter pattern is matched against the whole path from the\n      # repository root, and `**/` requires a directory, so '**/Dockerfile'\n      # does not match the root Dockerfile - the one this repository's own\n      # image is built from (issue #121).\n      - 'Dockerfile'\n      - '**/Dockerfile'\n      - '**/Dockerfile.*'\n      - '**/*.Dockerfile'\n      - '.hadolint.yaml'\n      - 'scripts/ci/run-hadolint.sh'\n      - '.github/workflows/dockerfiles.yml'\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      # A GitHub filter pattern is matched against the whole path from the\n      # repository root, and `**/` requires a directory, so '**/Dockerfile'\n      # does not match the root Dockerfile - the one this repository's own\n      # image is built from (issue #121).\n      - 'Dockerfile'\n      - '**/Dockerfile'\n      - '**/Dockerfile.*'\n      - '**/*.Dockerfile'\n      - '.hadolint.yaml'\n      - 'scripts/ci/run-hadolint.sh'\n      - '.github/workflows/dockerfiles.yml'\n  workflow_dispatch:\n\n# Least-privilege default; this job only reads the checked-out tree.\npermissions:\n  contents: read\n\nenv:\n  # actions/checkout's first act is `git init`, and a git with no configured\n  # `init.defaultBranch` answers it with a thirteen-line advice block - \"Using\n  # 'master' as the name for the initial branch... this default branch name will\n  # change\" - at the top of every job log. 19 checkouts in the runs issue #121\n  # lists printed 247 lines of it, in jobs where nothing was wrong. No step can\n  # fix it, because it is printed before the first step of ours runs; git reads\n  # configuration from the environment too, and the environment is there from\n  # the start. Ported from the js template, which carries the same three lines\n  # with the same reasoning.\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  hadolint:\n    name: dockerfiles / hadolint\n    runs-on: ubuntu-24.04\n    # Typical run: a few seconds once the image is pulled. The limit is here so\n    # a hung docker pull cannot hold a runner for six hours.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-hadolint\n      cancel-in-progress: true\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Nothing here pushes; leaving the token in .git/config would only\n          # widen what a compromised step could reach.\n          persist-credentials: false\n\n      # A pull_request checkout is GitHub's merge preview, computed when the\n      # pull request was last synchronised and never recomputed as main moves.\n      # Merge the base branch first, so this job reports on what merging would\n      # actually produce (issue #115, best practice #7).\n      - name: Simulate a fresh merge with the base branch\n        uses: ./.github/actions/simulate-fresh-merge\n\n      - name: List the Dockerfiles that will be checked\n        run: bash scripts/ci/run-hadolint.sh --list\n\n      # Threshold and the single ignored rule are in .hadolint.yaml, each with\n      # the reason. Reproduce locally with the identical command:\n      #   bash scripts/ci/run-hadolint.sh\n      - name: hadolint every tracked Dockerfile\n        run: bash scripts/ci/run-hadolint.sh\n\n      # Also part of run-experiments.sh, which scripts.yml runs on any '**.sh'\n      # or 'ubuntu/**' change - so the no-bare-apt policy it asserts is checked\n      # even when a pull request touches no Dockerfile at all.\n      - name: The runner's own fixtures still hold\n        run: bash experiments/test-issue115-hadolint-gate.sh\n\n  # === TERMINAL STATUS GATE ===\n  #\n  # The job that makes every other job's result reach the run's conclusion\n  # (issue #121, reference-template best practice \"every workflow gets a\n  # terminal status gate\").\n  #\n  # GitHub derives a run's conclusion from its jobs, and one cancellation\n  # outranks any number of failures - so a run holding a failed job can still\n  # come out grey, and everything that reads the run rather than each job (the\n  # badge, `gh run list`, the run list quoted in issue #121 itself) reads that\n  # as \"no verdict\" rather than \"something broke\". A gate's own conclusion is a\n  # job conclusion, so when it errors the run is red no matter what else was\n  # cancelled. The rationale, the measured run and the supersede-versus-overrun\n  # rule are in scripts/ci/check-pipeline-status.sh.\n  #\n  # `!cancelled()`, not `always()`: cancelling a whole run is somebody's\n  # decision and repainting it red would be a false positive, so this job is\n  # skipped there. `cancelled()` is run-level, so a job cancelled on its own -\n  # an overrun, or a per-job concurrency group firing - still reaches the gate.\n  #\n  # `needs` must name every other job in this file, or a job's result cannot\n  # reach here at all. That is not left to review:\n  # scripts/ci/check-status-gate-covers-all-jobs.mjs derives the list from this\n  # workflow and fails when the two disagree.\n  pipeline-status:\n    name: pipeline-status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    needs: [hadolint]\n    if: ${{ !cancelled() }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      # Anonymous `git ls-remote` is enough to resolve the branch head, which is\n      # how the script tells a superseded run from an overrun; no token is\n      # persisted for it.\n      - name: Check pipeline status\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          BRANCH_NAME: ${{ github.head_ref || github.ref_name }}\n        run: bash scripts/ci/check-pipeline-status.sh\n# lychee ignore patterns — regex matched against the URL.\n#\n# Ported from the reference template (issue #115, R5) and extended with the\n# hosts this repository actually links to.\n#\n# Every entry is a false positive: a URL that is correct but that a link\n# checker cannot verify - login-gated, rate-limited, bot-blocked, or served\n# over TLS lychee will not negotiate. A URL that is genuinely broken belongs in\n# the diff, not in this file; the first run of this gate found 111 of those and\n# every one was fixed. Each pattern below carries the reason it is here.\n\n# Localhost and local development URLs\nhttp://localhost\nhttps://localhost\nhttp://127\\.0\\.0\\.1\nhttps://127\\.0\\.0\\.1\n\n# Example/placeholder URLs commonly used in documentation\nhttps://example\\.com\nhttp://example\\.com\n\n# npmjs.com returns 403 to link checkers (bot protection)\nhttps://www\\.npmjs\\.com\n\n# medium.com returns 403 to link checkers (bot protection)\nhttps://medium\\.com\n\n# web.archive.org returns 502 to link checkers (bot protection)\nhttps://web\\.archive\\.org\n\n# GitHub repository settings pages require admin authentication; an anonymous\n# GET is 404 by design, for a URL the maintainer needs and that is correct.\nhttps://github\\.com/[^/]+/[^/]+/settings/\n\n# Docker Hub account settings redirect to the login flow, which lychee follows\n# in a loop and rejects. Same reason as the GitHub settings pages above.\nhttps://hub\\.docker\\.com/settings/\n\n# manpages.ubuntu.com answers 503 under any load, and gnu.org rate-limits\n# link checkers with 429. Both hosts are correct; their availability is not.\nhttps://manpages\\.ubuntu\\.com\nhttps://www\\.gnu\\.org\n\n# packages.ubuntu.com takes 19-30s to answer, so lychee's 30s timeout trips on\n# it often enough to fail the scheduled run on main. The pages are correct.\nhttps://packages\\.ubuntu\\.com\n\n# flatassembler.net offers no TLS suite lychee's rustls build will negotiate\n# (\"received fatal alert: HandshakeFailure\"). The site is up in a browser.\nhttps://(arm\\.)?flatassembler\\.net\n# Changesets\n\nThis folder is used to track version changes using the changeset methodology.\n\n## How to add a changeset\n\nWhen you make changes that should trigger a version bump, create a new markdown file in this directory with the following format:\n\n```markdown\n---\nbump: patch\n---\n\nDescription of what changed\n```\n\nThe `bump` field can be:\n- `patch` - Bug fixes, minor updates (1.0.0 -> 1.0.1)\n- `minor` - New features, backwards compatible (1.0.0 -> 1.1.0)\n- `major` - Breaking changes (1.0.0 -> 2.0.0)\n\n## How it works\n\n1. Contributors add changeset files in their PRs\n2. When merged to main, the CI workflow detects changesets\n3. CI automatically bumps the VERSION file and creates a release\n4. The changeset files are deleted after the version is applied\n\n## File naming\n\nUse descriptive names for changeset files, e.g.:\n- `add-python-support.md`\n- `fix-entrypoint-script.md`\n- `update-nodejs-version.md`\n\nOr use random names like: `happy-dogs-jump.md`\n","exit_code":0,"status":"completed"}}
