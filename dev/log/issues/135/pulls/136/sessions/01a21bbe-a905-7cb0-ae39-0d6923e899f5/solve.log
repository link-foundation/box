ce('| Errors | 0 |', '| Errors | 1 |')],\n      ['2', temporary + '\\\\n* [404] <broken'],\n    ]) {\n      writeFileSync(output, '');\n      writeFileSync(reportFile, content);\n      const run = spawnSync(process.execPath, ['scripts/ci/recheck-broken-links.mjs'], {\n        env: { ...process.env, LYCHEE_EXIT_CODE: code, LYCHEE_OUTPUT: reportFile,\n          GITHUB_OUTPUT: output, RECOVERED_OUTPUT: recovered, RECHECK_BUDGET_SECONDS: '0' },\n        encoding: 'utf8',\n      });\n      assert.equal(run.status, 0, run.stderr);\n      assert.match(run.stderr, /checker exit status or report is incomplete/);\n      assert.equal(readFileSync(output, 'utf8'), '');\n    }\n  } finally {\n    rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest('link recovery tests the same GET method as the checker', async () => {\n  const result = await recheckFailures([url], {\n    accept: '200..=299', userAgent: 'lychee', budgetSeconds: 1,\n    fetchImpl: async (_, request) => new Response(null, {\n      status: request.method === 'HEAD' ? 200 : 404,\n    }),\n  });\n  assert.deepEqual(result.recovered, []);\n  assert.equal(result.stillBroken[0].status, 404);\n});\n\ntest('an archive outage or invalid payload is distinct from a successful empty lookup', async () => {\n  const lookup = (response) => checkWaybackMachine(url, { fetchImpl: async () => response });\n  assert.deepEqual(await lookup(new Response(null, { status: 503 })), {\n    available: false, error: 'HTTP 503',\n  });\n  assert.deepEqual(await lookup(Response.json({})), {\n    available: false, error: 'invalid snapshot response',\n  });\n  assert.deepEqual(await lookup(Response.json({ archived_snapshots: {} })), { available: false });\n  assert.deepEqual(await lookup(Response.json({\n    archived_snapshots: { closest: { available: true, timestamp: '20201011040051',\n      url: 'http://web.archive.org/web/20201011040051/https://example.org' } },\n  })), { available: true, timestamp: '20201011040051',\n    archiveUrl: 'https://web.archive.org/web/20201011040051/https://example.org' });\n});\nJS\nSH\ncat >experiments/test-issue135-measure-workflow.sh <<'SH'\n#\"'!/usr/bin/env bash\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\n\nruby -ryaml - <<'\"'RUBY'\nworkflow = YAML.load_file('.github/workflows/measure-disk-space.yml')\njob = workflow.fetch('jobs').fetch('measure-disk-space')\nabort 'measurement must wait for the fast checks' unless job.fetch('needs') == 'validate'\nsteps = job.fetch('steps')\nnamed = steps.to_h { |step| [step['name'], step] }\nmeasure = named.fetch('Run disk space measurement').fetch('run')\nabort 'measurement must write and check fresh output' unless measure.include?('--json-output measurement.json') && measure.include?('[ -s measurement.json ]')\nvalidate = named.fetch('Validate measurements')\nupdate = named.fetch('Update README with component sizes')\npublish = named.fetch('Commit and push changes')\nabort 'validate the fresh result before updating the README' unless steps.index(validate) < steps.index(update) && validate.fetch('run').end_with?('validate-measurements.py measurement.json')\nabort 'publication must be main-only' unless publish.fetch('if').include?(\\\"github.ref == 'refs/heads/main'\\\")\nputs 'Measurement workflow ordering, output isolation, and publication guard passed.'\nRUBY\nSH\ngit diff --check\nbash experiments/test-issue135-link-verdicts.sh\nbash experiments/test-issue135-measure-workflow.sh\"","aggregated_output":"✔ both consumers read errors and timeouts and ignore redirects (4.011523ms)\n✔ a runtime failure or incomplete report cannot be recovered (237.01563ms)\n✔ link recovery tests the same GET method as the checker (48.905392ms)\n✔ an archive outage or invalid payload is distinct from a successful empty lookup (12.406279ms)\nℹ tests 4\nℹ suites 0\nℹ pass 4\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 324.636018\nMeasurement workflow ordering, output isolation, and publication guard passed.\n","exit_code