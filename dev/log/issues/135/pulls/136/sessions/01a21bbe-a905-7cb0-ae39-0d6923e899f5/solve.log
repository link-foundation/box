x      # rewrite the files in place\nscripts/ci/run-shfmt.sh:42:#   bash scripts/ci/run-shfmt.sh --list     # print the file set, format nothing\nscripts/ci/run-shfmt.sh:43:#   bash scripts/ci/run-shfmt.sh --list-inputs  # the same set, paths only\nscripts/ci/run-shfmt.sh:44:#   bash scripts/ci/run-shfmt.sh path/to.sh # only these files\nscripts/ci/run-shfmt.sh:47:#   SHFMT_IMAGE    Docker image used when shfmt is not on PATH\nscripts/ci/run-shfmt.sh:53:#   2  shfmt could not run, or ran without producing a usable answer\nscripts/ci/run-shfmt.sh:61:IMAGE=\"${SHFMT_IMAGE:-mvdan/shfmt:v3.10.0}\"\nscripts/ci/run-shfmt.sh:79:# let shfmt's silence pass for a verdict; discovery needed the same refusal.\nscripts/ci/run-shfmt.sh:101:    echo \"::error title=shfmt::could not list this repository's shell scripts - git ls-files failed and printed the reason above. Nothing was formatted or checked; this is not a clean run.\" >&2\nscripts/ci/run-shfmt.sh:105:    echo \"::error title=shfmt::discovery matched no shell script at all. Either the globs ('*.sh', '.githooks/*') are wrong or this is not the repository they were written for; a gate that read nothing must not report a clean tree.\" >&2\nscripts/ci/run-shfmt.sh:138:      echo \"run-shfmt.sh: unknown option $1\" >&2\nscripts/ci/run-shfmt.sh:160:  echo \"::error title=shfmt::no shell scripts to format. Nothing was checked, so this is an error and not a clean run.\" >&2\nscripts/ci/run-shfmt.sh:169:if command -v shfmt >/dev/null 2>&1; then\nscripts/ci/run-shfmt.sh:170:  RUNNER=(shfmt)\nscripts/ci/run-shfmt.sh:172:  echo \"==> shfmt not on PATH; using ${IMAGE}\"\nscripts/ci/run-shfmt.sh:174:  # `shfmt -w` replaces each file rather than writing through the inode, so\nscripts/ci/run-shfmt.sh:179:  # experiments/test-issue115-shfmt-gate.sh, which reruns the fixture after\nscripts/ci/run-shfmt.sh:183:  echo \"::error title=shfmt unavailable::Neither shfmt nor docker is available, so the shell scripts were not formatted. Install sh