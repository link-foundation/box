N STEP\t2026-11-24T17:02:34.0089251Z ^[[36;1mecho \"  3. Pin a GitHub link to the commit that still holds the file.\"^[[0m\nlinks / lychee\tUNKNOWN STEP\t2026-11-24T17:02:34.0089724Z ^[[36;1mecho \"  4. Delete the link if the content is gone and not worth citing.\"^[[0m\nlinks / lychee\tUNKNOWN STEP\t2026-11-24T17:02:34.0090207Z ^[[36;1mecho \"  5. Add the URL to .lycheeignore *with a reason* - but only if\"^[[0m\nlinks / lychee\tUNKNOWN STEP\t2026-11-24T17:02:34.0090685Z ^[[36;1mecho \"     the link is correct and merely unverifiable (login-gated,\"^[[0m\nlinks / lychee\tUNKNOWN STEP\t2026-11-24T17:02:34.0091142Z ^[[36;1mecho \"     rate-limited, bot-blocked). A dead link is not a false\"^[[0m\n95:# Run command with sudo only if not root and sudo is available\n96:maybe_sudo() {\n99:  elif command_exists sudo; then\n100:    sudo \"$@\"\n152:# Retry apt metadata refreshes, the same way ubuntu/24.04/common.sh does. This\n156:# The three -o options restate apt's own defaults on Ubuntu 24.04 (apt 2.8.3) -\n157:# measured, a bare `apt-get update` retries three times and times an idle\n158:# connection out after 30s - so the `apt-get install` lines further down this\n159:# file are not weaker for omitting them. The retry loop here is what apt does\n160:# not do by itself. See experiments/test-issue123-apt-retry-defaults.sh for the\n162:apt_update_with_retry() {\n169:    log_info \"Updating apt sources (attempt ${attempt}/${max_retries})...\"\n170:    if maybe_sudo apt-get update -y \\\n183:    log_warning \"Apt update failed; clearing apt list state and retrying in ${delay}s\"\n184:    maybe_sudo rm -rf /var/lib/apt/lists/partial /var/lib/apt/lists/*\n203:  # Clean apt cache (downloaded .deb files) but preserve package lists\n204:  # NOTE: We intentionally do NOT delete /var/lib/apt/lists/* as it breaks\n206:  maybe_sudo apt-get clean 2>/dev/null || true\n209:  maybe_sudo rm -rf /tmp/* 2>/dev/null || true\n210:  maybe_sudo rm -rf /var/tmp/* 2>/dev/null || true\n324:# Measure apt package installation\n325:measure_apt_install() {\n331:  measure_install \"$name\" \"$category\" maybe_sudo apt-get install -y $packages\n352:if [ \"$EUID\" -ne 0 ] && ! sudo -n true 2>/dev/null; then\n353:  log_error \"This script requires sudo access.\"\n364:  usermod -aG sudo box 2>/dev/null || true\n373:  # ubuntu/24.04/js/Dockerfile explains why. Never overwrites, so a re-run is a\n385:apt_update_with_retry || true\n397:DOTNET_SDK_CHANNEL=\"$(box_resolve resolve_dotnet_apt_channel 8.0)\"\n401:measure_apt_install \"Essential Tools\" \"System\" \\\n402:  wget curl unzip zip git sudo ca-certificates gnupg build-essential expect screen\n409:measure_apt_install \".NET SDK ${DOTNET_SDK_CHANNEL}\" \"Runtime\" \"dotnet-sdk-${DOTNET_SDK_CHANNEL}\"\n410:measure_apt_install \"C/C++ Tools (CMake, Clang, LLVM, LLD)\" \"Build Tools\" cmake clang llvm lld\n411:measure_apt_install \"Assembly Tools (NASM, FASM)\" \"Build Tools\" nasm fasm\n420:  apt_update_with_retry || true\n#!/usr/bin/env bash\n# Reproduce PR 132's GitHub 503 failures without accessing the network.\n# Set RECHECK_TEST_SCRIPT to an earlier script to verify the reproducer fails.\nset -euo pipefail\ncd \"$(dirname \"${BASH_SOURCE[0]}\")/..\"\n\nnode --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { execFile } from 'node:child_process';\nimport { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';\nimport { createServer } from 'node:http';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { test } from 'node:test';\nimport { pathToFileURL } from 'node:url';\nimport { promisify } from 'node:util';\n\nconst run = promisify(execFile);\nconst script = process.env.RECHECK_TEST_SCRIPT || 'scripts/ci/recheck-broken-links.mjs';\nconst recheckModule = await import(pathToFileURL(path.resolve(script)));\nconst recheckFailures = recheckModule.recheckFailures || recheckModule.recheckUnanswered;\n\n// Drive the actual CLI, including report parsing and GitHub Actions outputs.\nasync function withFixture(check) {\n  const work = await mkdtemp(path.join(os.tmpdir(), 'issue131-links-'));\n  const requests = [];\n  const server = createServer((req, res) => {\n    requests.push(req.url);\n    const attempt = requests.filter((url) => url === req.url).length;\n    const temporaryStatus = Number(req.url.match(/^\\/status-(\\d+)$/)?.[1] || 503);\n    const status = req.url === '/persistent' ? 503\n      : req.url === '/gone' ? 404\n      : req.url === '/becomes-gone' ? (attempt === 1 ? 503 : 404)\n      : (attempt === 1 ? temporaryStatus : 200);\n    res.writeHead(status);\n    res.end();\n  });\n  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n  const base = `http://127.0.0.1:${server.address().port}`;\n  const report = (status, suffix) =>\n    `* [${status}] <${base}${suffix}> (at 72:2) | Rejected status code: ${status}\\n`;\n  const recheck = async (content, budget = '2') => {\n    await writeFile(path.join(work, 'report.md'), content);\n    await writeFile(path.join(work, 'output'), '');\n    await rm(path.join(work, 'recovered'), { force: true });\n    const { stdout } = await run(process.execPath,\n      [script], {\n        env: { ...process.env,\n          LYCHEE_OUTPUT: path.join(work, 'report.md'),\n          RECOVERED_OUTPUT: path.join(work, 'recovered'),\n          GITHUB_OUTPUT: path.join(work, 'output'),\n          RECHECK_BUDGET_SECONDS: budget,\n          RECHECK_WAIT_MS: '5',\n        },\n      });\n    return {\n      stdout,\n      output: await readFile(path.join(work, 'output'), 'utf8'),\n      recovered: await readFile(path.join(work, 'recovered'), 'utf8')\n        .catch((error) => { if (error.code === 'ENOENT') return ''; throw error; }),\n    };\n  };\n  try {\n    await check({ base, report, recheck, requests });\n  } finally {\n    await new Promise((resolve) => server.close(resolve));\n    await rm(work, { recursive: true, force: true });\n  }\n}\n\ntest('the two HTTP 503 failures recover only after successful responses', { timeout: 5000 }, async () => {\n  await withFixture(async ({ base, report, recheck, requests }) => {\n    const result = await recheck(report(503, '/sysbox') + report(503, '/podman'));\n    assert.equal(result.output, 'all_recovered=true\\n');\n    assert.equal(result.recovered, `${base}/sysbox\\n${base}/podman\\n`);\n    assert.deepEqual(requests, ['/sysbox', '/podman', '/sysbox', '/podman']);\n  });\n});\n\ntest('temporary HTTP statuses in numeric markers and error details are retried', { timeout: 5000 }, async () => {\n  await withFixture(async ({ report, recheck }) => {\n    for (const status of [408, 429, 500, 502, 503, 504]) {\n      const result = await recheck(report(status, `/status-${status}`));\n      assert.equal(result.output, 'all_recovered=true\\n', `HTTP ${status}`);\n    }\n    const result = await recheck(report(503, '/detail').replace('[503]', '[ERROR]'));\n    assert.equal(result.output, 'all_recovered=true\\n');\n  });\n});\n\ntest('404s, missing files, and broken fragments remain failures alongside a recovered 503', { timeout: 5000 }, async () => {\n  await withFixture(async ({ base, report, recheck, requests }) => {\n    const result = await recheck(report(503, '/healthy') + report(404, '/gone') +\n      report(403, '/denied') + report(501, '/unsupported') +\n      '* [ERROR] <file:///missing.md> | File not found\\n' +\n      `* [200] <${base}/fragment#missing> | Failed to resolve fragment\\n` +\n      report(503, '/temporary#missing'));\n    assert.equal(result.output, '');\n    assert.equal(result.recovered, `${base}/healthy\\n`);\n    assert.deepEqual(requests, ['/healthy', '/healthy']);\n  });\n});\n\ntest('a persistent 503 exhausts the budget and never sets all_recovered', { timeout: 5000 }, async () => {\n  await withFixture(async ({ report, recheck, requests }) => {\n    const result = await recheck(report(503, '/persistent'), '0.5');\n    assert.equal(result.output, '');\n    assert.equal(result.recovered, '');\n    assert.ok(requests.length > 0 && requests.length < 10);\n    assert.match(result.stdout, /Still broken:.*503/);\n  });\n});\n\ntest('a temporary error followed by a 404 stops retrying and stays failed', { timeout: 5000 }, async () => {\n  await withFixture(async ({ report, recheck, requests }) => {\n    const result = await recheck(report(503, '/becomes-gone'));\n    assert.equal(result.output, '');\n    assert.equal(result.recovered, '');\n    assert.deepEqual(requests, ['/becomes-gone', '/becomes-gone']);\n    assert.match(result.stdout, /Still broken:.*404/);\n  });\n});\n\ntest('the same temporary failure cited in two files counts as one recovered URL', { timeout: 5000 }, async () => {\n  await withFixture(async ({ report, recheck }) => {\n    const result = await recheck(report(503, '/duplicate').repeat(2));\n    assert.equal(result.output, 'all_recovered=true\\n');\n  });\n});\n\ntest('one slow request cannot exceed the budget or start requests after it', { timeout: 5000 }, async () => {\n  let calls = 0;\n  const started = Date.now();\n  const result = await recheckFailures(['https://example.com/a', 'https://example.com/b'], {\n    accept: '200..=299', userAgent: 'lychee', budgetSeconds: 0.03, initialWaitMs: 5,\n    fetchImpl: async (_url, { signal }) => {\n      calls += 1;\n      return new Promise((_, reject) => {\n        // Bound the fixture independently of the production abort timer so\n        // running against the old implementation cannot hold the test open.\n        const timer = setTimeout(() => reject(new Error('fixture expired')), 50);\n        signal.addEventListener('abort', () => {\n          clearTimeout(timer);\n          reject(new Error('aborted'));\n        }, { once: true });\nscripts/ci/run-experiments.sh:2:# run-experiments.sh - Run the repository's experiment/regression suites.\nscripts/ci/run-experiments.sh:5:#   bash scripts/ci/run-experiments.sh [--list] [--list-inputs] [--verbose]\nscripts/ci/run-experiments.sh:10:# not checks. Two of them (test-issue90, test-issue92) had been *crashing* on\nscripts/ci/run-experiments.sh:50:      echo \"run-experiments.sh: unknown option $1\" >&2\nscripts/ci/run-experiments.sh:71:  ['test-issue121-provenance-metadata-leak.sh']=\"needs docker: drives a real buildx build to reproduce the metadata provenance leak (its offline twin, test-issue121-log-injection.sh, runs here)\"\nscripts/ci/run-experiments.sh:73:  ['reproduce-issue123-zizmor-offline-audits.sh']=\"needs docker, a network and a GitHub token: run…re)\"\nscripts/ci/run-experiments.sh:74:  ['reproduce-issue133-containerd-pid.sh']=\"needs docker and a privileged box-dind image: commits a running nested daemon and resumes it to reproduce the stale containerd pid file (its offline twin, test-issue133-stale-pid-files.sh, runs here; tests/dind/example-snapshot-resume.sh covers it in PR CI)\"\nscripts/ci/run-experiments.sh:75:  ['reproduce-issue121-actionlint-version-gap.sh']=\"needs docker and a network: runs two pinned actionlint images over the same fixtures to measure which checks the older one cannot make; a measurement, not an assertion (the version floor it argues for is asserted offline by test-issue121-workflow-audit-scope.sh)\"\nscripts/ci/run-experiments.sh:88:    echo \"::error title=run-experiments::SKIP_SUITES names '$skipped_name', which does not exist under $SKIP_ROOT/. Either the suite was renamed or the subscript was rewritten; an entry that matches nothing silently stops skipping.\" >&2\n.github/workflows/scripts.yml:104:        run: bash experiments/test-issue115-heredoc-unbound-vars.sh\n.github/workflows/scripts.yml:153:        run: bash experiments/test-issue121-awk-portability.sh\n.github/workflows/scripts.yml:199:        run: bash experiments/test-issue121-mjs-syntax.sh\n.github/workflows/scripts.yml:203:  # shellcheck and shfmt take *.sh, run-experiments.sh discovers *.sh, and the\n.github/workflows/scripts.yml:244:        run: bash experiments/test-issue121-py-syntax.sh\n.github/workflows/scripts.yml:287:        run: bash experiments/test-issue115-shellcheck-gate.sh\n.github/workflows/scripts.yml:300:  # `[node-lts-integration-test.sh]` in run-experiments.sh into a different\n.github/workflows/scripts.yml:335:        run: bash experiments/test-issue115-shfmt-gate.sh\n.github/workflows/scripts.yml:365:        run: bash scripts/ci/run-experiments.sh --list\n.github/workflows/scripts.yml:376:            bash scripts/ci/run-experiments.sh\n.github/workflows/scripts.yml:385:      # actually ran, and require files when it did. run-experiments.sh:124-125\n","exit_code":0,"status":"completed"}}
