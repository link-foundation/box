cy\n    runs-on: ubuntu-24.04\n    # Caps are sized from what the jobs actually take, measured over the last\n    # 300 runs and tabulated in docs/CI-TIMEOUT-BUDGETS.md; this one has never\n    # exceeded 1.1 minutes. A cap far above the work it bounds is not free\n    # caution - it is the number of minutes a hung job burns before anyone hears\n    # about it (issue #121).\n    timeout-minutes: 10\n    if: |\n      !cancelled() &&\n      (inputs.version-check-result == 'success' || inputs.version-check-result == 'skipped') &&\n      (inputs.changeset-check-result == 'success' || inputs.changeset-check-result == 'skipped') &&\n      github.event_name == 'pull_request'\n    # The guard below cancels this run when its commit is superseded, which\n    # needs write access to the Actions API (issue #112 follow-up).\n    permissions:\n      contents: read\n      actions: write\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v6\n        with:\n          # Nothing here pushes; leaving the token in .git/config would only\n          # widen what a compromised step could reach.\n          persist-credentials: false\n\n      # A queued matrix job can start long after the run was created, by which\n      # time the pull request may have moved on (issue #112 follow-up). Check\n      # before spending a runner on a commit nobody is waiting for.\n      - name: Stop if a newer commit superseded this run\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR_NUMBER: ${{ github.event.pull_request.number }}\n          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n        run: |\n          bash scripts/ci/supersede.sh stop-if-superseded\n          # ...and keep watching from inside the job. Cancelling from the\n          # outside needs a free runner, and a superseded run holding every\n          # slot is exactly why there is none.\nSecurity\tin_progress\t\nScripts\tin_progress\t\nDocs\tcompleted\tsuccess\nFile sizes\tcompleted\tsuccess\nMeasure Disk Space and Update README\tcompleted\tsuccess\nBuild and Release Docker Image\tin_progress\t\nLinks\tcompleted\tsuccess\nWorkflows\tcompleted\tsuccess\nDockerfiles\tcompleted\tsuccess\n","exit_code":0,"status":"completed"}}
