[2026-11-27T07:05:50.928Z] [STDOUT] {"type":"item.started","item":{"id":"item_203","type":"command_execution","command":"/bin/bash -lc 'p=dev/log/issues/135/pulls/136\npython3 - \"$p\" <<'\"'PY' > /tmp/box-135-log-dispositions.tsv\nimport gzip, io, re, sys\nfrom pathlib import Path\nfrom zipfile import ZipFile\n\nroot = Path(sys.argv[1])\nwarning = re.compile(r'\\\\bwarning\\\\b|\\\\bwarn\\\\b|\\\\bdeprecated\\\\b|\\\\bdeprecation\\\\b', re.I)\nactive = re.compile(r'\\\\b(update-alternatives: warning:|npm warn|W: |warning:|##\\\\[warning\\\\]|\"'^WARN[ '\"\\\\t]|will be removed|deprecated)', re.I)\nsecret = [REDACTED_SECRET]'(gh[pousr]_[A-Za-z0-9]{35,}|github_pat_[A-Za-z0-9_]{80,}|-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----|AKIA[A-Z0-9]{16})')\ncounts = {}\n\ndef read(path, label, stream):\n    matches = set()\n    tokens = 0\n    for n, line in enumerate(stream, 1):\n        if secret.search(line):\n            tokens += 1\n        line = line.decode('utf-8','replace').strip()\n        if warning.search(line) and active.search(line):\n            line = re.sub(r'\"'^.*?20'\"\\\\d\\\\d-\\\\d\\\\d-\\\\d\\\\dT[\"'^ ]+Z '\"', '', line)\n            if line not in matches:\n                matches.add(line)\n                print(path.name, label, str(n), line[:260], sep='\\\\t')\n    if tokens:\n        print('POTENTIAL_SECRET_COUNT', path.name, label, tokens, sep='\\\\t', file=sys.stderr)\n\nfor path in sorted((root/'ci-logs').iterdir()):\n    if path.suffix == '.gz':\n        with gzip.open(path,'rb') as stream: read(path,'',stream)\n    if path.suffix == '.zip':\n        with ZipFile(path) as archive:\n            for entry in archive.namelist():\n                if re.match(r'\"'^'\"\\\\d+_.+\\\\.txt\"'$'\"',entry):\n                    with archive.open(entry) as stream: read(path,entry,stream)\nPY\nwc -l /tmp/box-135-log-dispositions.tsv\ncut -f4 /tmp/box-135-log-dispositions.tsv | sort | uniq -c | sort -rn | head -35\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
