# syntax=docker/dockerfile:1
# What the full image used to do: copy the whole stage, then try to clean up.
# whiteout-stage is built by experiments/rust-refresh-layer-test.sh right before
# this file, in the local daemon; there is no tag to pin.
# hadolint ignore=DL3006
FROM whiteout-stage AS rust-stage
FROM ubuntu:24.04
COPY --from=rust-stage /opt/toolchains /opt/toolchains
RUN rm -rf /opt/toolchains/stale
